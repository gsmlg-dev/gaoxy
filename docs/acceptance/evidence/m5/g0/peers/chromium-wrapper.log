export LD_LIBRARY_PATH="$LD_LIBRARY_PATH${LD_LIBRARY_PATH:+:}/nix/store/xa0vq1ipwx6a2z14f8y6pmvnjql0g5pi-libva-2.23.0/lib:/nix/store/qwcq8cjnhm686yjdrjfcrrw95jv6dhpn-pipewire-1.6.6/lib:/nix/store/4qangvdf3rkv93bpi2sjjg695zcs2mqx-wayland-1.25.0/lib:/nix/store/nz1phhjgpbg6gb1dlcvarf0bm61aj97c-gtk+3-3.24.52/lib:/nix/store/8g01hy2crkmnjb5v1b6nmgbfrs6y4h39-gtk4-4.22.4/lib:/nix/store/v6ibq54l47kz8m62gm5p4dqr8sjgy4c9-krb5-1.22.2-lib/lib"

# libredirect causes chromium to deadlock on startup
export LD_PRELOAD="$(echo -n "$LD_PRELOAD" | /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/tr ':' '\n' | /nix/store/sacz532zgiacvg7mva9v6gbfmyw427i3-gnugrep-3.12/bin/grep -v /lib/libredirect\\.so$ | /nix/store/gph17gb73p6qbrqqjnypfjj5npf0ldyx-coreutils-9.11/bin/tr '\n' ':')"

