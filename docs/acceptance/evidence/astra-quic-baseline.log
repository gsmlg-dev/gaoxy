{
  "apps/gaoxy/lib/gaoxy/quic.ex": "defmodule Gaoxy.QUIC do\n  @moduledoc \"\"\"\n  Bounded optional facade over opaque `Abyss.QUIC` handles; no protocol engine.\n\n  Writes admit at most min(configured output, 16 KiB). Reads consume at most\n  min(requested bytes, configured input, 16 KiB). A write receipt is admission,\n  not local UDP completion or peer delivery. Resolve unknown references with\n  `operation_status/2` on the connection; never automatically retry them.\n  Only the attached callback owner can reserve application I/O bytes.\n  \"\"\"\n  alias Gaoxy.Admission\n\n  defmodule Connection do\n    @moduledoc false\n    @enforce_keys [:handle, :gate, :lease, :limits, :scope]\n    defstruct @enforce_keys\n  end\n\n  defmodule Stream do\n    @moduledoc false\n    @enforce_keys [:handle, :connection]\n    defstruct @enforce_keys\n  end\n\n  def ready(%Connection{handle: handle}), do: Abyss.QUIC.ready(handle)\n  def info(%Connection{handle: handle}), do: Abyss.QUIC.info(handle)\n\n  def operation_status(%Connection{handle: handle}, reference),\n    do: Abyss.QUIC.operation_status(handle, reference)\n\n  def open_stream(%Connection{} = connection, kind, options \\\\ []) do\n    with {:ok, options} <- options(options, connection),\n         {:ok, handle} <- Abyss.QUIC.open_stream(connection.handle, kind, options),\n         do: {:ok, %Stream{handle: handle, connection: connection}}\n  end\n\n  def read(%Stream{} = stream, maximum, options \\\\ []) do\n    with true <- (is_integer(maximum) and maximum > 0) || {:error, :invalid_read_limit},\n         {:ok, options} <- options(options, stream.connection) do\n      limit = min(maximum, min(stream.connection.limits.max_packet, 16_384))\n      Abyss.QUIC.read(stream.handle, limit, options)\n    end\n  end\n\n  def send_stream(stream, bytes, fin \\\\ false, options \\\\ [])\n\n  def send_stream(%Stream{connection: connection} = stream, bytes, fin, options)\n      when is_binary(bytes) and is_boolean(fin) do\n    size = byte_size(bytes)\n\n    with true <- size <= min(connection.limits.max_output, 16_384) || {:error, :output_limit},\n         {:ok, options} <- options(options, connection),\n         :ok <- Admission.adjust_bytes(connection.gate, connection.lease, size) do\n      try do\n        with {:ok, operation} <- Admission.start_send(connection.gate, connection.lease, size) do\n          result =\n            Abyss.QUIC.send_stream(\n              stream.handle,\n              bytes,\n              fin,\n              Keyword.put(options, :ref, operation)\n            )\n\n          recorded =\n            case result do\n              {:ok, ^operation} -> {:admitted, operation}\n              {:unknown, ^operation} -> {:unknown, operation}\n              {:blocked, reason} when is_atom(reason) -> {:blocked, reason}\n              {:error, reason} when is_atom(reason) -> {:error, reason}\n              _ -> {:error, :quic_send_failed}\n            end\n\n          :ok = Admission.finish_send(connection.gate, connection.lease, operation, recorded)\n          result\n        end\n      after\n        Admission.adjust_bytes(connection.gate, connection.lease, -size)\n      end\n    end\n  end\n\n  def send_stream(_, _, _, _), do: {:error, :invalid_write}\n\n  def reset_stream(%Stream{} = stream, code, options \\\\ []) do\n    with {:ok, options} <- options(options, stream.connection),\n         do: Abyss.QUIC.reset_stream(stream.handle, code, options)\n  end\n\n  def stop_stream(%Stream{} = stream, code, options \\\\ []) do\n    with {:ok, options} <- options(options, stream.connection),\n         do: Abyss.QUIC.stop_stream(stream.handle, code, options)\n  end\n\n  def close(%Connection{} = connection, code \\\\ 0, reason \\\\ <<>>, options \\\\ []) do\n    with {:ok, options} <- options(options, connection),\n         do: Abyss.QUIC.close(connection.handle, code, reason, options)\n  end\n\n  defp options(options, connection) do\n    if Keyword.keyword?(options) and\n         Keyword.keys(options) -- [:timeout, :deadline] == [] and\n         length(options) == map_size(Map.new(options)) and\n         is_integer(Keyword.get(options, :timeout, 1)) and\n         Keyword.get(options, :timeout, 1) in 1..connection.limits.callback_timeout and\n         is_integer(Keyword.get(options, :deadline, 0)) do\n      {:ok, Keyword.put_new(options, :timeout, min(1_000, connection.limits.callback_timeout))}\n    else\n      {:error, :invalid_operation_options}\n    end\n  end\nend\n",
  "apps/gaoxy/lib/gaoxy/quic_bridge.ex": "defmodule Gaoxy.QUICBridge do\n  @moduledoc false\n  @behaviour Abyss.QUIC.Handler\n  alias Gaoxy.{Admission, QUIC}\n\n  @impl true\n  def init(handle, metadata, %{spec: spec, gate: gate, scope: scope} = context) do\n    with {:ok, lease} <- Admission.acquire(gate, 0),\n         :ok <- Admission.begin(gate, lease, 0) do\n      connection = %QUIC.Connection{\n        handle: handle,\n        gate: gate,\n        lease: lease,\n        limits: spec.limits,\n        scope: scope\n      }\n\n      with {:ok, app} <- spec.handler.init(connection, metadata, spec.handler_options),\n           :ok <- retain(connection, app) do\n        {:ok, Map.merge(context, %{connection: connection, app: app})}\n      end\n    end\n  end\n\n  @impl true\n  def handle_event(event, %{connection: connection, app: app} = state) do\n    with :ok <- Admission.begin(connection.gate, connection.lease, :erlang.external_size(app)) do\n      case state.spec.handler.handle_event(event(event, connection), app) do\n        {:ok, next} ->\n          case retain(connection, next) do\n            :ok -> {:ok, %{state | app: next}}\n            {:error, reason} -> {:stop, reason, state}\n          end\n\n        {:stop, reason, next} ->\n          case retain(connection, next) do\n            :ok -> {:stop, reason, %{state | app: next}}\n            {:error, failure} -> {:stop, failure, state}\n          end\n      end\n    else\n      {:error, reason} -> {:stop, reason, state}\n    end\n  end\n\n  @impl true\n  def terminate(reason, state) do\n    if function_exported?(state.spec.handler, :terminate, 2) do\n      :ok =\n        Admission.begin(\n          state.connection.gate,\n          state.connection.lease,\n          :erlang.external_size(state.app)\n        )\n\n      state.spec.handler.terminate(reason, state.app)\n    end\n  end\n\n  defp event({:stream_open, handle, kind}, connection),\n    do: {:stream_open, %QUIC.Stream{handle: handle, connection: connection}, kind}\n\n  defp event({:readable, handle}, connection),\n    do: {:readable, %QUIC.Stream{handle: handle, connection: connection}}\n\n  defp event({:stopped, handle, code}, connection),\n    do: {:stopped, %QUIC.Stream{handle: handle, connection: connection}, code}\n\n  defp event(other, _), do: other\n\n  defp retain(connection, app) do\n    size = :erlang.external_size(app)\n\n    if size <= connection.limits.max_state,\n      do: Admission.retain(connection.gate, connection.lease, size),\n      else: {:error, :state_limit}\n  end\nend\n",
  "apps/gaoxy/lib/gaoxy/quic_handler.ex": "defmodule Gaoxy.QUICHandler do\n  @moduledoc \"\"\"\n  Opt-in connection/stream callbacks hosted by public `Abyss.QUIC`.\n\n  Callbacks run in the engine-attached connection owner. Use `Gaoxy.QUIC` with\n  the supplied connection/stream capabilities. FIN, reset, stop, blocked and\n  unknown operation receipts retain their native directional meanings. No\n  listener socket or listener-close capability is given to an application.\n  \"\"\"\n  @callback init(term(), map(), term()) :: {:ok, term()} | {:error, term()}\n  @callback handle_event(term(), term()) :: {:ok, term()} | {:stop, term(), term()}\n  @callback terminate(term(), term()) :: term()\n  @optional_callbacks terminate: 2\nend\n",
  "apps/gaoxy/lib/gaoxy/service.ex": "defmodule Gaoxy.Service do\n  @moduledoc false\n  use GenServer, restart: :transient\n  alias Gaoxy.{Admission, Telemetry}\n  def start_link(args), do: GenServer.start_link(__MODULE__, args)\n\n  @impl true\n  def init({table, id, instance}) do\n    Process.flag(:trap_exit, true)\n    [{^id, spec}] = :ets.lookup(table, id)\n    generation = make_ref()\n    scope = %{instance: instance, service: id, generation: generation}\n    {:ok, _} = Registry.register(Gaoxy.Registry, {instance, id}, generation)\n    {:ok, gate} = Admission.start_link({spec.limits, scope})\n    context = %{spec: spec, gate: gate, scope: scope}\n\n    result =\n      try do\n        start_backend(spec, context)\n      rescue\n        error -> {:error, {:backend_configuration, error.__struct__}}\n      catch\n        :exit, reason -> {:error, {:backend_start, reason}}\n      end\n\n    case result do\n      {:ok, backend} ->\n        {:ok, _} = Telemetry.bind_backend(backend, scope)\n        Telemetry.emit(:lifecycle, %{count: 1}, scope, %{state: :ready})\n\n        {:ok,\n         %{\n           spec: spec,\n           table: table,\n           backend: backend,\n           gate: gate,\n           scope: scope,\n           generation: generation,\n           mode: :ready,\n           drain: nil\n         }}\n\n      {:error, reason} ->\n        GenServer.stop(gate)\n        {:stop, reason}\n    end\n  end\n\n  @impl true\n  def handle_call({:request, generation, _}, _, state)\n      when not is_nil(generation) and generation != state.generation,\n      do: {:reply, {:error, :stale_generation}, state}\n\n  def handle_call({:request, _, :handle}, _, state),\n    do: {:reply, %{id: state.spec.id, generation: state.generation}, state}\n\n  def handle_call({:request, _, :info}, _, state),\n    do:\n      {:reply,\n       %{\n         id: state.spec.id,\n         generation: state.generation,\n         transport: state.spec.transport,\n         mode: state.mode,\n         local: local(state),\n         pause:\n           case state.spec.transport do\n             :udp -> :admission_only\n             :quic -> :unsupported\n             _ -> :unbind_rebind\n           end,\n         drain: if(state.spec.transport == :quic, do: :local_host_cleanup, else: :admitted_work)\n       }, state}\n\n  def handle_call({:request, _, :status}, _, state),\n    do:\n      {:reply,\n       Map.merge(Admission.status(state.gate), %{\n         state: state.mode,\n         backend: backend_status(state)\n       }), state}\n\n  def handle_call({:request, _, operation}, _, %{mode: mode} = state)\n      when operation in [:pause, :resume] and mode in [:draining, :stopped],\n      do: {:reply, {:error, mode}, state}\n\n  def handle_call({:request, _, operation}, _, %{spec: %{transport: :quic}} = state)\n      when operation in [:pause, :resume],\n      do: {:reply, {:error, {:unsupported_capability, :quic_pause}}, state}\n\n  def handle_call({:request, _, :pause}, _, state) do\n    :ok = Admission.mode(state.gate, :paused)\n\n    case host(state).suspend(state.backend) do\n      :ok -> {:reply, :ok, transition(state, :paused)}\n      error -> {:reply, error, state}\n    end\n  end\n\n  def handle_call({:request, _, :resume}, _, state) do\n    case host(state).resume(state.backend) do\n      :ok ->\n        Admission.mode(state.gate, :ready)\n        {:reply, :ok, transition(state, :ready)}\n\n      error ->\n        {:reply, error, state}\n    end\n  end\n\n  def handle_call({:request, _, :memberships}, _, state),\n    do: {:reply, membership_list(state), state}\n\n  def handle_call({:request, _, {:membership, operation, membership}}, _, state) do\n    result = membership_change(state, operation, membership)\n\n    if result == :ok do\n      spec = put_in(state.spec, [:udp, :memberships], Abyss.memberships(state.backend))\n      :ets.insert(state.table, {spec.id, spec})\n      {:reply, :ok, %{state | spec: spec}}\n    else\n      {:reply, result, state}\n    end\n  end\n\n  def handle_call({:drain, generation, timeout}, from, state)\n      when generation == state.generation and is_nil(state.drain) do\n    :ok = Admission.mode(state.gate, :draining)\n    deadline = System.monotonic_time(:millisecond) + timeout\n    owner = self()\n    backend = state.backend\n    host = host(state)\n    # Only control work is spawned. Datagram processing never creates rejected-work tasks.\n    {pid, monitor} =\n      spawn_monitor(fn ->\n        result =\n          if host in [Abyss, Abyss.QUIC] do\n            host.stop(backend, max(0, deadline - System.monotonic_time(:millisecond)))\n          else\n            ThousandIsland.suspend(backend)\n            send(owner, {:tcp_admission_stopped, self()})\n\n            receive do\n              :close_backend -> Supervisor.stop(backend, :normal, :infinity)\n            end\n          end\n\n        send(owner, {:drained, self(), result})\n      end)\n\n    token = make_ref()\n    timer = Process.send_after(self(), {:drain_deadline, token}, timeout)\n    if host not in [Abyss, Abyss.QUIC], do: send(self(), :check_drain)\n\n    drain = %{\n      pid: pid,\n      monitor: monitor,\n      from: from,\n      timer: timer,\n      token: token,\n      deadline: deadline\n    }\n\n    {:noreply, %{transition(state, :draining) | drain: drain}}\n  end\n\n  def handle_call({:drain, _, _}, _, state),\n    do: {:reply, {:error, :already_draining_or_stale}, state}\n\n  @impl true\n  def handle_info(:check_drain, %{drain: nil} = state), do: {:noreply, state}\n\n  def handle_info(:check_drain, state) do\n    if Admission.status(state.gate).active == 0 do\n      send(state.drain.pid, :close_backend)\n    else\n      Process.send_after(self(), :check_drain, 5)\n    end\n\n    {:noreply, state}\n  end\n\n  def handle_info({:drained, pid, :ok}, %{drain: %{pid: pid}} = state),\n    do: finish_drain(state, :completed)\n\n  def handle_info({:drain_deadline, token}, %{drain: %{token: token}} = state) do\n    Process.exit(state.backend, :kill)\n    Process.exit(state.drain.pid, :kill)\n    finish_drain(state, :forced)\n  end\n\n  def handle_info({:EXIT, pid, _}, %{backend: pid, mode: mode} = state)\n      when mode in [:draining, :stopped], do: {:noreply, state}\n\n  def handle_info({:EXIT, pid, reason}, state) when pid == state.backend or pid == state.gate,\n    do: {:stop, {:backend_failed, reason}, state}\n\n  def handle_info({:DOWN, monitor, :process, _pid, reason}, %{drain: %{monitor: monitor}} = state)\n      when reason != :normal,\n      do: finish_drain(state, {:cleanup_error, reason})\n\n  def handle_info(_, state), do: {:noreply, state}\n  @impl true\n  def terminate(_, state) do\n    if state.drain, do: Process.exit(state.drain.pid, :kill)\n    if Process.alive?(state.gate), do: GenServer.stop(state.gate)\n\n    if Process.alive?(state.backend) do\n      try do\n        Supervisor.stop(state.backend, :normal, 1_000)\n      catch\n        :exit, _ -> Process.exit(state.backend, :kill)\n      end\n    end\n  end\n\n  defp finish_drain(state, outcome) do\n    Process.cancel_timer(state.drain.timer)\n    GenServer.reply(state.drain.from, :ok)\n    Telemetry.emit(:drain, %{count: 1}, state.scope, %{outcome: outcome})\n    {:noreply, %{transition(state, :stopped) | drain: nil}}\n  end\n\n  defp transition(state, mode) do\n    Telemetry.emit(:lifecycle, %{count: 1}, state.scope, %{state: mode})\n    %{state | mode: mode}\n  end\n\n  defp host(%{spec: %{transport: :udp}}), do: Abyss\n  defp host(%{spec: %{transport: :quic}}), do: Abyss.QUIC\n  defp host(_), do: ThousandIsland\n  defp local(%{mode: :stopped}), do: {:error, :stopped}\n  defp local(%{spec: %{transport: :quic}} = state), do: Abyss.QUIC.local(state.backend)\n\n  defp local(%{spec: %{transport: :udp}} = state) do\n    case Abyss.Listener.for_server(state.backend) do\n      [listener] -> Abyss.Listener.listener_info(listener)\n      _ -> {:error, :not_ready}\n    end\n  end\n\n  defp local(state), do: ThousandIsland.listener_info(state.backend)\n  defp backend_status(%{mode: :stopped}), do: :stopped\n  defp backend_status(%{spec: %{transport: :quic}}), do: :quic_connection_host\n\n  defp backend_status(%{spec: %{transport: :udp}} = state) do\n    case Abyss.Listener.for_server(state.backend) do\n      [listener] -> Abyss.Listener.status(listener)\n      _ -> :not_ready\n    end\n  end\n\n  defp backend_status(_), do: :stream\n\n  defp membership_list(%{spec: %{transport: :udp, mode: :multicast}} = state),\n    do: Abyss.memberships(state.backend)\n\n  defp membership_list(_), do: {:error, {:unsupported_capability, :memberships}}\n\n  defp membership_change(\n         %{spec: %{transport: :udp, mode: :multicast}, mode: mode} = state,\n         operation,\n         membership\n       )\n       when mode in [:ready, :paused] do\n    with true <-\n           Gaoxy.Config.valid_membership?(membership, state.spec.ip) ||\n             {:error, :invalid_membership},\n         {:ok, canonical} <- Abyss.Transport.UDP.Multicast.normalize_membership(membership) do\n      current = Abyss.memberships(state.backend)\n\n      if operation == :join and canonical not in current and\n           length(current) >= state.spec.limits.max_memberships do\n        {:error, :membership_limit}\n      else\n        apply(Abyss, operation, [state.backend, membership])\n      end\n    end\n  end\n\n  defp membership_change(_, _, _), do: {:error, {:unsupported_capability, :memberships}}\n\n  defp start_backend(%{transport: :udp} = spec, context) do\n    transport =\n      case spec.mode do\n        :unicast -> Abyss.Transport.UDP.Unicast\n        :broadcast -> Abyss.Transport.UDP.Broadcast\n        :multicast -> Abyss.Transport.UDP.Multicast\n      end\n\n    options =\n      Enum.map(Map.get(spec.udp, :memberships, []), &{:add_membership, &1}) ++\n        Map.to_list(Map.drop(spec.udp, [:memberships, :inet_backend]))\n\n    options = [\n      {:inet_backend, Map.get(spec.udp, :inet_backend, :inet)},\n      if(tuple_size(spec.ip) == 8, do: :inet6, else: :inet),\n      {:ip, spec.ip} | options\n    ]\n\n    Abyss.start_link(\n      handler_module: Gaoxy.DatagramBridge,\n      handler_options: context,\n      port: spec.port,\n      transport_module: transport,\n      transport_options: options,\n      num_listeners: 1,\n      num_connections: spec.limits.max_active,\n      max_packet_size: spec.limits.max_packet,\n      admission_start_timeout: spec.limits.callback_timeout,\n      read_timeout: spec.limits.idle_timeout,\n      shutdown_timeout: spec.limits.drain_timeout,\n      connection_telemetry_sample_rate: 1.0\n    )\n  end\n\n  defp start_backend(%{transport: :quic} = spec, context) do\n    with {:ok, tls} <- quic_credentials(spec.tls) do\n      Abyss.QUIC.start_link(\n        handler: {Gaoxy.QUICBridge, context},\n        ip: spec.ip,\n        port: spec.port,\n        alpn: spec.quic.alpn,\n        tls: tls,\n        max_connections: spec.limits.max_active,\n        init_timeout: spec.limits.callback_timeout,\n        callback_timeout: spec.limits.callback_timeout,\n        shutdown_timeout: spec.limits.drain_timeout,\n        writer_timeout: spec.limits.callback_timeout,\n        writer_max_queue: spec.limits.max_active,\n        writer_max_bytes: spec.limits.max_bytes,\n        quic_options: [\n          streams: [\n            max_data: spec.limits.max_bytes,\n            max_stream_data: spec.limits.max_bytes,\n            max_buffer: spec.limits.max_bytes,\n            max_ready_bytes: spec.limits.max_bytes,\n            max_streams_bidi: spec.limits.max_active,\n            max_streams_uni: spec.limits.max_active,\n            max_stream_records: spec.limits.max_active * 2,\n            max_recv_ranges: 128\n          ]\n        ]\n      )\n    end\n  end\n\n  defp start_backend(spec, context) do\n    tls =\n      if spec.transport == :tls do\n        [\n          certfile: spec.tls.certfile,\n          keyfile: spec.tls.keyfile,\n          versions: Map.get(spec.tls, :versions, [:\"tlsv1.3\"]),\n          alpn_preferred_protocols: Map.get(spec.tls, :alpn, [])\n        ]\n      else\n        []\n      end\n\n    ThousandIsland.start_link(\n      handler_module: Gaoxy.StreamBridge,\n      handler_options: context,\n      port: spec.port,\n      transport_module:\n        if(spec.transport == :tls,\n          do: ThousandIsland.Transports.SSL,\n          else: ThousandIsland.Transports.TCP\n        ),\n      transport_options: [\n        if(tuple_size(spec.ip) == 8, do: :inet6, else: :inet),\n        {:ip, spec.ip},\n        {:send_timeout, spec.limits.callback_timeout},\n        {:send_timeout_close, true} | tls\n      ],\n      num_acceptors: 1,\n      num_connections: spec.limits.max_active,\n      max_connections_retry_count: 0,\n      read_timeout: spec.limits.idle_timeout,\n      handshake_timeout: spec.limits.callback_timeout,\n      shutdown_timeout: spec.limits.drain_timeout\n    )\n  end\n\n  defp quic_credentials(tls) do\n    with {:ok, certificate} <- File.read(tls.certfile),\n         {:ok, key} <- File.read(tls.keyfile),\n         certificates when certificates != [] <-\n           for(\n             {:Certificate, der, :not_encrypted} <- :public_key.pem_decode(certificate),\n             do: der\n           ),\n         [{type, der, :not_encrypted}] <- :public_key.pem_decode(key) do\n      {:ok, [cert: certificates, key: {type, der}]}\n    else\n      {:error, reason} -> {:error, reason}\n      _ -> {:error, :invalid_quic_credentials}\n    end\n  end\nend\n",
  "apps/gaoxy/lib/gaoxy/config.ex": "defmodule Gaoxy.Config do\n  @moduledoc \"Pure, strict validation of trusted embedded specifications. No sockets are opened.\"\n  @limits %{\n    max_active: 64,\n    max_bytes: 1_048_576,\n    max_packet: 65_507,\n    max_output: 65_507,\n    max_state: 65_536,\n    callback_timeout: 5_000,\n    idle_timeout: 30_000,\n    drain_timeout: 5_000,\n    max_memberships: 64\n  }\n  @keys [\n    :id,\n    :transport,\n    :handler,\n    :handler_options,\n    :ip,\n    :port,\n    :mode,\n    :tls,\n    :udp,\n    :quic,\n    :limits,\n    :capabilities\n  ]\n\n  def validate(options) do\n    with :ok <- keyword(options),\n         :ok <- known(Map.new(options), [:services, :name]),\n         true <- is_list(Keyword.get(options, :services, [])) || {:error, :invalid_services},\n         {:ok, services} <- services(Keyword.get(options, :services, []), []) do\n      {:ok, %{name: Keyword.get(options, :name), services: services}}\n    end\n  end\n\n  def service(input) when is_map(input) do\n    limits = Map.merge(@limits, Map.get(input, :limits, %{}))\n\n    spec =\n      Map.merge(\n        %{\n          ip: {127, 0, 0, 1},\n          port: 0,\n          mode: :unicast,\n          tls: %{},\n          udp: %{},\n          quic: %{},\n          handler_options: [],\n          capabilities: []\n        },\n        input\n      )\n      |> Map.put(:limits, limits)\n\n    with :ok <- known(input, @keys),\n         :ok <- identity(spec),\n         :ok <- limit_check(input, limits),\n         :ok <- transport(spec),\n         :ok <- handler(spec),\n         :ok <- requested(spec) do\n      {:ok, spec}\n    end\n  rescue\n    BadMapError -> {:error, :invalid_options}\n    ArgumentError -> {:error, :invalid_options}\n  end\n\n  def service(_), do: {:error, :invalid_service}\n\n  def conflicts(a, b) do\n    family = fn spec -> if spec.transport in [:udp, :quic], do: :udp, else: :tcp end\n\n    a.port != 0 and a.port == b.port and family.(a) == family.(b) and\n      tuple_size(a.ip) == tuple_size(b.ip) and\n      (a.ip == b.ip or wildcard?(a.ip) or wildcard?(b.ip))\n  end\n\n  defp services([], acc), do: {:ok, Enum.reverse(acc)}\n\n  defp services([input | rest], acc) do\n    with {:ok, spec} <- service(input), :ok <- unique(spec, acc) do\n      services(rest, [spec | acc])\n    end\n  end\n\n  defp unique(spec, existing) do\n    cond do\n      Enum.any?(existing, &(&1.id == spec.id)) ->\n        {:error, {:duplicate_service, spec.id}}\n\n      conflict = Enum.find(existing, &conflicts(&1, spec)) ->\n        {:error, {:binding_conflict, spec.id, conflict.id}}\n\n      true ->\n        :ok\n    end\n  end\n\n  defp keyword(options) do\n    if Keyword.keyword?(options) and length(options) == map_size(Map.new(options)),\n      do: :ok,\n      else: {:error, :invalid_options}\n  end\n\n  defp known(options, keys) when is_map(options) do\n    case Map.keys(options) -- keys do\n      [] -> :ok\n      unknown -> {:error, {:unknown_options, Enum.sort(unknown)}}\n    end\n  end\n\n  defp known(_, _), do: {:error, :invalid_options}\n\n  defp identity(%{id: id, ip: ip, port: port}) do\n    if ((is_atom(id) and not is_nil(id)) or (is_binary(id) and byte_size(id) in 1..128)) and\n         valid_ip?(ip) and is_integer(port) and port in 0..65_535,\n       do: :ok,\n       else: {:error, :invalid_identity_or_binding}\n  end\n\n  defp identity(_), do: {:error, :missing_identity}\n\n  defp valid_ip?(ip) when is_tuple(ip) and tuple_size(ip) in [4, 8] do\n    max = if tuple_size(ip) == 4, do: 255, else: 65_535\n    Enum.all?(Tuple.to_list(ip), &(is_integer(&1) and &1 in 0..max))\n  end\n\n  defp valid_ip?(_), do: false\n  defp wildcard?(ip), do: Enum.all?(Tuple.to_list(ip), &(&1 == 0))\n\n  defp limit_check(input, limits) do\n    with :ok <- known(Map.get(input, :limits, %{}), Map.keys(@limits)),\n         true <-\n           Enum.all?(limits, fn {_, n} -> is_integer(n) and n > 0 end) ||\n             {:error, :invalid_limits},\n         true <-\n           (limits.max_packet <= 65_507 and limits.max_memberships <= 64) ||\n             {:error, :invalid_limits} do\n      :ok\n    end\n  end\n\n  defp transport(%{transport: :quic} = spec) do\n    with true <- Code.ensure_loaded?(Quic) || {:error, {:unsupported_capability, :quic}},\n         :ok <- known(spec.quic, [:alpn]),\n         true <-\n           (valid_alpn?(spec.quic[:alpn]) and spec.quic[:alpn] != []) || {:error, :invalid_alpn},\n         :ok <- known(spec.tls, [:certfile, :keyfile]),\n         true <-\n           (is_binary(spec.tls[:certfile]) and is_binary(spec.tls[:keyfile])) ||\n             {:error, :missing_credentials},\n         true <- tuple_size(spec.ip) == 4 || {:error, {:unsupported_capability, :quic_ipv6}},\n         true <- not wildcard?(spec.ip) || {:error, :wildcard_bind_unsupported},\n         :ok <- empty(spec.udp),\n         :ok <- unicast(spec.mode),\n         do: :ok\n  end\n\n  defp transport(%{transport: :tls, tls: %{provider: provider}}) when provider != :otp,\n    do: {:error, {:unsupported_capability, provider}}\n\n  defp transport(%{transport: :tls} = spec) do\n    with :ok <- empty(spec.quic),\n         :ok <- known(spec.tls, [:provider, :certfile, :keyfile, :alpn, :versions]),\n         true <-\n           (is_binary(spec.tls[:certfile]) and is_binary(spec.tls[:keyfile])) ||\n             {:error, :missing_credentials},\n         true <- valid_alpn?(Map.get(spec.tls, :alpn, [])) || {:error, :invalid_alpn},\n         true <-\n           Map.get(spec.tls, :versions, [:\"tlsv1.3\"]) in [\n             [:\"tlsv1.3\"],\n             [:\"tlsv1.2\"],\n             [:\"tlsv1.3\", :\"tlsv1.2\"]\n           ] || {:error, :invalid_tls_versions},\n         :ok <- empty(spec.udp),\n         :ok <- unicast(spec.mode) do\n      :ok\n    end\n  end\n\n  defp transport(%{transport: :tcp} = spec) do\n    with :ok <- empty(spec.tls),\n         :ok <- empty(spec.udp),\n         :ok <- empty(spec.quic),\n         do: unicast(spec.mode)\n  end\n\n  defp transport(%{transport: :udp, mode: :broadcast, ip: ip}) when tuple_size(ip) == 8,\n    do: {:error, {:unsupported_capability, :ipv6_broadcast}}\n\n  defp transport(%{transport: :udp} = spec) do\n    with :ok <- empty(spec.quic),\n         :ok <- empty(spec.tls),\n         true <- spec.mode in [:unicast, :broadcast, :multicast] || {:error, :invalid_udp_mode},\n         :ok <-\n           known(spec.udp, [\n             :memberships,\n             :multicast_if,\n             :multicast_ttl,\n             :multicast_loop,\n             :strict_group_filter,\n             :inet_backend\n           ]),\n         :ok <- udp_options(spec) do\n      :ok\n    end\n  end\n\n  defp transport(_), do: {:error, :invalid_transport}\n\n  defp udp_options(spec) do\n    memberships = Map.get(spec.udp, :memberships, [])\n\n    cond do\n      Map.get(spec.udp, :inet_backend, :inet) not in [:inet, :socket] ->\n        {:error, :invalid_backend}\n\n      not is_list(memberships) ->\n        {:error, :invalid_memberships}\n\n      length(memberships) > spec.limits.max_memberships ->\n        {:error, :membership_limit}\n\n      spec.mode != :multicast and map_size(Map.delete(spec.udp, :inet_backend)) != 0 ->\n        {:error, :multicast_options_require_multicast}\n\n      not Enum.all?(memberships, &valid_membership?(&1, spec.ip)) ->\n        {:error, :invalid_membership}\n\n      not is_boolean(Map.get(spec.udp, :multicast_loop, true)) ->\n        {:error, :invalid_loopback}\n\n      not is_boolean(Map.get(spec.udp, :strict_group_filter, false)) ->\n        {:error, :invalid_filter}\n\n      not (is_integer(Map.get(spec.udp, :multicast_ttl, 1)) and\n               Map.get(spec.udp, :multicast_ttl, 1) in 0..255) ->\n        {:error, :invalid_ttl}\n\n      tuple_size(spec.ip) == 8 and spec.mode == :multicast and :os.type() != {:unix, :linux} ->\n        {:error, {:unsupported_capability, :ipv6_multicast}}\n\n      true ->\n        :ok\n    end\n  end\n\n  def valid_membership?({group, interface}, ip) do\n    valid_ip?(group) and tuple_size(group) == tuple_size(ip) and\n      Abyss.Transport.UDP.Multicast.multicast_address?(group) and\n      if(tuple_size(ip) == 8,\n        do:\n          (is_integer(interface) and interface > 0) or\n            (is_binary(interface) and byte_size(interface) > 0),\n        else:\n          interface == :any or (is_binary(interface) and byte_size(interface) > 0) or\n            (valid_ip?(interface) and tuple_size(interface) == 4)\n      )\n  end\n\n  def valid_membership?(_, _), do: false\n\n  defp handler(%{transport: :quic, handler: module}) when is_atom(module) do\n    if Code.ensure_loaded?(module) and function_exported?(module, :init, 3) and\n         function_exported?(module, :handle_event, 2), do: :ok, else: {:error, :invalid_handler}\n  end\n\n  defp handler(%{transport: type, handler: module}) when is_atom(module) do\n    callback = if type == :udp, do: {:handle_datagram, 2}, else: {:handle_data, 2}\n\n    if Code.ensure_loaded?(module) and\n         function_exported?(module, elem(callback, 0), elem(callback, 1)) and\n         (type == :udp or function_exported?(module, :init, 2)),\n       do: :ok,\n       else: {:error, :invalid_handler}\n  end\n\n  defp handler(_), do: {:error, :invalid_handler}\n\n  defp requested(spec) do\n    supported =\n      if spec.transport == :quic do\n        [:quic, :local_cleanup]\n      else\n        [spec.transport, :pause, :drain] ++ if(spec.transport == :udp, do: [spec.mode], else: [])\n      end\n\n    if is_list(spec.capabilities) do\n      case spec.capabilities -- supported do\n        [] -> :ok\n        [cap | _] -> {:error, {:unsupported_capability, cap}}\n      end\n    else\n      {:error, :invalid_capabilities}\n    end\n  end\n\n  defp valid_alpn?(list) when is_list(list),\n    do: Enum.all?(list, &(is_binary(&1) and byte_size(&1) in 1..255))\n\n  defp valid_alpn?(_), do: false\n  defp empty(map) when map == %{}, do: :ok\n  defp empty(_), do: {:error, :inapplicable_options}\n  defp unicast(:unicast), do: :ok\n  defp unicast(_), do: {:error, :inapplicable_mode}\nend\n",
  "apps/gaoxy/lib/gaoxy/admission.ex": "defmodule Gaoxy.Admission do\n  @moduledoc false\n  use GenServer\n  alias Gaoxy.Telemetry\n\n  def start_link({limits, scope}), do: GenServer.start_link(__MODULE__, {limits, scope})\n  def acquire(gate, bytes), do: GenServer.call(gate, {:acquire, bytes})\n  def begin(gate, lease, bytes), do: GenServer.call(gate, {:begin, lease, bytes})\n  def retain(gate, lease, bytes), do: GenServer.call(gate, {:retain, lease, bytes})\n  def update(gate, lease, bytes), do: GenServer.call(gate, {:update, lease, bytes})\n  def adjust_bytes(gate, lease, delta), do: GenServer.call(gate, {:adjust_bytes, lease, delta})\n  def start_send(gate, lease, bytes), do: GenServer.call(gate, {:start_send, lease, bytes})\n\n  def finish_send(gate, lease, operation, result),\n    do: GenServer.call(gate, {:finish_send, lease, operation, result})\n\n  def mode(gate, mode), do: GenServer.call(gate, {:mode, mode})\n  def status(gate), do: GenServer.call(gate, :status)\n\n  @impl true\n  def init({limits, scope}),\n    do:\n      {:ok,\n       %{\n         limits: limits,\n         scope: scope,\n         mode: :ready,\n         leases: %{},\n         bytes: 0,\n         high_water: 0,\n         rejected: 0\n       }}\n\n  @impl true\n  def handle_call({:acquire, bytes}, {pid, _}, state) do\n    cond do\n      state.mode != :ready ->\n        reject(state, state.mode)\n\n      map_size(state.leases) >= state.limits.max_active ->\n        reject(state, :active_limit)\n\n      not is_integer(bytes) or bytes < 0 or state.bytes + bytes > state.limits.max_bytes ->\n        reject(state, :byte_limit)\n\n      true ->\n        ref = make_ref()\n        monitor = Process.monitor(pid)\n        lease = %{pid: pid, monitor: monitor, bytes: bytes, token: nil, timer: nil, send: nil}\n        state = %{state | leases: Map.put(state.leases, ref, lease), bytes: state.bytes + bytes}\n        {:reply, {:ok, ref}, sample(state)}\n    end\n  end\n\n  def handle_call({action, ref, bytes}, {pid, _}, state)\n      when action in [:begin, :retain, :update] do\n    case state.leases[ref] do\n      %{pid: ^pid} = lease ->\n        new_bytes = state.bytes - lease.bytes + bytes\n\n        if is_integer(bytes) and bytes >= 0 and new_bytes <= state.limits.max_bytes do\n          lease =\n            case action do\n              :begin ->\n                cancel(lease)\n                token = make_ref()\n\n                timer =\n                  Process.send_after(\n                    self(),\n                    {:expired, ref, token},\n                    state.limits.callback_timeout\n                  )\n\n                %{lease | timer: timer, token: token, bytes: bytes}\n\n              :retain ->\n                cancel(lease)\n                %{lease | timer: nil, token: nil, bytes: bytes}\n\n              :update ->\n                %{lease | bytes: bytes}\n            end\n\n          {:reply, :ok,\n           sample(%{state | bytes: new_bytes, leases: Map.put(state.leases, ref, lease)})}\n        else\n          reject(state, :byte_limit)\n        end\n\n      _ ->\n        {:reply, {:error, :stale_generation}, state}\n    end\n  end\n\n  def handle_call({:mode, mode}, _from, state), do: {:reply, :ok, %{state | mode: mode}}\n\n  def handle_call({:adjust_bytes, ref, delta}, {pid, _}, state) when is_integer(delta) do\n    case state.leases[ref] do\n      %{pid: ^pid} = lease ->\n        if lease.bytes + delta >= 0 and state.bytes + delta <= state.limits.max_bytes do\n          {:reply, :ok,\n           sample(%{\n             state\n             | bytes: state.bytes + delta,\n               leases: Map.put(state.leases, ref, %{lease | bytes: lease.bytes + delta})\n           })}\n        else\n          reject(state, :byte_limit)\n        end\n\n      _ ->\n        {:reply, {:error, :stale_generation}, state}\n    end\n  end\n\n  def handle_call({:start_send, ref, bytes}, {pid, _}, state) do\n    case state.leases[ref] do\n      %{pid: ^pid, send: nil} = lease when is_integer(bytes) and bytes >= 0 ->\n        operation = make_ref()\n        pending = %{operation: operation, bytes: bytes}\n        Telemetry.emit(:send_started, %{bytes: bytes}, state.scope, %{operation: operation})\n\n        {:reply, {:ok, operation},\n         %{state | leases: Map.put(state.leases, ref, %{lease | send: pending})}}\n\n      _ ->\n        {:reply, {:error, :stale_or_pending_send}, state}\n    end\n  end\n\n  def handle_call({:finish_send, ref, operation, result}, {pid, _}, state) do\n    case state.leases[ref] do\n      %{pid: ^pid, send: %{operation: ^operation} = pending} = lease ->\n        outcome =\n          case result do\n            {:error, :timeout} -> {:unknown, :timeout}\n            {:error, {:timeout, _remaining}} -> {:unknown, :timeout}\n            other -> other\n          end\n\n        send_outcome(state, pending, outcome)\n        {:reply, :ok, %{state | leases: Map.put(state.leases, ref, %{lease | send: nil})}}\n\n      _ ->\n        {:reply, {:error, :stale_operation}, state}\n    end\n  end\n\n  def handle_call(:status, _from, state) do\n    {:reply,\n     %{\n       active: map_size(state.leases),\n       retained_bytes: state.bytes,\n       retained_high_water: state.high_water,\n       rejected: state.rejected,\n       queued_items: 0,\n       queued_bytes: 0\n     }, state}\n  end\n\n  @impl true\n  def handle_info({:expired, ref, token}, state) do\n    case state.leases[ref] do\n      %{token: ^token, pid: pid} = lease ->\n        Telemetry.emit(:timeout, %{count: 1}, state.scope, %{reason: :callback_or_send_timeout})\n        send_outcome(state, lease.send, {:unknown, :watchdog_timeout})\n        Process.exit(pid, :kill)\n        {:noreply, %{state | leases: Map.put(state.leases, ref, %{lease | send: nil})}}\n\n      _ ->\n        {:noreply, state}\n    end\n  end\n\n  def handle_info({:DOWN, monitor, :process, _pid, _reason}, state) do\n    case Enum.find(state.leases, fn {_, lease} -> lease.monitor == monitor end) do\n      {ref, lease} ->\n        cancel(lease)\n        send_outcome(state, lease.send, {:unknown, :owner_exit})\n\n        {:noreply,\n         sample(%{\n           state\n           | leases: Map.delete(state.leases, ref),\n             bytes: state.bytes - lease.bytes\n         })}\n\n      nil ->\n        {:noreply, state}\n    end\n  end\n\n  def handle_info(_, state), do: {:noreply, state}\n  @impl true\n  def terminate(_, state),\n    do:\n      Enum.each(state.leases, fn {_, lease} ->\n        send_outcome(state, lease.send, {:unknown, :forced_cleanup})\n        Process.exit(lease.pid, :kill)\n      end)\n\n  defp send_outcome(_, nil, _), do: :ok\n\n  defp send_outcome(state, pending, outcome),\n    do:\n      Telemetry.emit(:send, %{bytes: pending.bytes}, state.scope, %{\n        operation: pending.operation,\n        outcome: outcome\n      })\n\n  defp cancel(%{timer: nil}), do: :ok\n  defp cancel(%{timer: timer}), do: Process.cancel_timer(timer)\n\n  defp reject(state, reason) do\n    Telemetry.emit(:admission_rejected, %{count: 1}, state.scope, %{reason: reason})\n    {:reply, {:error, reason}, %{state | rejected: state.rejected + 1}}\n  end\n\n  defp sample(state) do\n    Telemetry.emit(\n      :work,\n      %{active: map_size(state.leases), retained_bytes: state.bytes},\n      state.scope\n    )\n\n    %{state | high_water: max(state.high_water, state.bytes)}\n  end\nend\n",
  "integration/quic_consumer/test/quic_test.exs": "defmodule GaoxyQUICConsumerTest do\n  use ExUnit.Case, async: true\n  alias Gaoxy.QUIC\n  @moduletag :tmp_dir\n  @moduletag timeout: 120_000\n\n  defmodule Echo do\n    @behaviour Gaoxy.QUICHandler\n    def init(connection, metadata, observer) do\n      send(observer, {:connection, connection, metadata})\n\n      {:ok,\n       %{connection: connection, local: false, streams: %{}, pending: %{}, observer: observer}}\n    end\n\n    def handle_event({:stream_open, stream, :bidi}, state),\n      do: {:ok, %{state | streams: Map.put(state.streams, stream, :echo)}}\n\n    def handle_event(event, state) when event in [:tick, :writable], do: progress(state)\n    def handle_event({:readable, _}, state), do: progress(state)\n    def handle_event(_, state), do: {:ok, state}\n\n    defp progress(state) do\n      state = open_local(state)\n\n      Enum.reduce_while(state.streams, {:ok, state}, fn {stream, kind}, {:ok, acc} ->\n        with {:ok, next} <- read(acc, stream, kind), {:ok, next} <- flush(next, stream) do\n          {:cont, {:ok, next}}\n        else\n          failure -> {:halt, failure}\n        end\n      end)\n    end\n\n    defp open_local(%{local: true} = state), do: state\n\n    defp open_local(state) do\n      case QUIC.open_stream(state.connection, :bidi) do\n        {:ok, stream} ->\n          send(\n            state.observer,\n            {:bounds, QUIC.send_stream(stream, :binary.copy(\"x\", 4097)), QUIC.read(stream, 0),\n             QUIC.open_stream(state.connection, :bidi, ref: make_ref())}\n          )\n\n          send(state.observer, {:flow_control, QUIC.send_stream(stream, :binary.copy(\"x\", 4096))})\n\n          %{\n            state\n            | local: true,\n              streams: Map.put(state.streams, stream, :local),\n              pending: Map.put(state.pending, stream, {\"server-fin\", true})\n          }\n\n        {:blocked, _} ->\n          state\n      end\n    end\n\n    defp read(state, stream, kind) do\n      if Map.has_key?(state.pending, stream) do\n        {:ok, state}\n      else\n        case QUIC.read(stream, 1024) do\n          {:ok, items} ->\n            {:ok,\n             Enum.reduce(items, state, fn\n               {:data, _, bytes}, s when kind == :echo ->\n                 pending(s, stream, bytes, false)\n\n               {:fin, _}, s when kind == :echo ->\n                 pending(s, stream, <<>>, true)\n\n               {:data, _, bytes}, s ->\n                 send(s.observer, {:after_fin, bytes})\n                 s\n\n               {:fin, _}, s ->\n                 %{s | streams: Map.delete(s.streams, stream)}\n\n               {:reset, _, _, _}, s ->\n                 %{s | streams: Map.delete(s.streams, stream)}\n             end)}\n\n          error ->\n            {:stop, {:read_failed, error}, state}\n        end\n      end\n    end\n\n    defp pending(state, stream, bytes, fin) do\n      {previous, _} = Map.get(state.pending, stream, {<<>>, false})\n      %{state | pending: Map.put(state.pending, stream, {previous <> bytes, fin})}\n    end\n\n    defp flush(state, stream) do\n      case state.pending[stream] do\n        nil ->\n          {:ok, state}\n\n        {bytes, fin} ->\n          case QUIC.send_stream(stream, bytes, fin) do\n            {:ok, operation} ->\n              send(\n                state.observer,\n                {:write, operation, QUIC.operation_status(stream.connection, operation)}\n              )\n\n              streams =\n                if fin and state.streams[stream] == :echo,\n                  do: Map.delete(state.streams, stream),\n                  else: state.streams\n\n              {:ok, %{state | streams: streams, pending: Map.delete(state.pending, stream)}}\n\n            {:blocked, reason} ->\n              send(state.observer, {:blocked, reason})\n              {:ok, state}\n\n            failure ->\n              {:stop, {:write_failed, failure}, state}\n          end\n      end\n    end\n  end\n\n  defmodule Controls do\n    @behaviour Gaoxy.QUICHandler\n    def init(_, _, observer), do: {:ok, %{observer: observer}}\n\n    def handle_event({:readable, stream}, state) do\n      {:ok, items} = QUIC.read(stream, 1024)\n\n      for {:data, _, bytes} <- items do\n        case bytes do\n          \"reset\" -> send(state.observer, {:reset_result, QUIC.reset_stream(stream, 0x12345)})\n          \"stop\" -> send(state.observer, {:stop_result, QUIC.stop_stream(stream, 0x54321)})\n        end\n      end\n\n      {:ok, state}\n    end\n\n    def handle_event(_, state), do: {:ok, state}\n  end\n\n  defmodule TCP do\n    def init(_, _), do: {:ok, nil}\n    def handle_data(bytes, state), do: {:send, bytes, state}\n  end\n\n  test \"public optional host: verified streams, directional controls, bounds and isolation\", %{\n    tmp_dir: directory\n  } do\n    {_, 0} = System.cmd(\"bash\", [\"../../scripts/generate-fixtures.sh\", directory])\n\n    services =\n      for {id, handler} <- [{\"echo\", Echo}, {\"controls\", Controls}] do\n        %{\n          id: id,\n          transport: :quic,\n          handler: handler,\n          handler_options: self(),\n          tls: %{\n            certfile: Path.join(directory, \"cert.pem\"),\n            keyfile: Path.join(directory, \"key.pem\")\n          },\n          quic: %{alpn: [\"gaoxy-stream-v1\"]},\n          limits: %{max_active: 4, max_packet: 4096, max_output: 4096, max_bytes: 262_144}\n        }\n      end\n\n    runtime =\n      start_supervised!(\n        {Gaoxy, services: services ++ [%{id: \"tcp\", transport: :tcp, handler: TCP}]}\n      )\n\n    {:ok, {_, echo}} = Gaoxy.info(runtime, \"echo\").local\n    {:ok, {_, controls}} = Gaoxy.info(runtime, \"controls\").local\n    assert %{pause: :unsupported, drain: :local_host_cleanup} = Gaoxy.info(runtime, \"echo\")\n    assert {:error, {:unsupported_capability, :quic_pause}} = Gaoxy.pause(runtime, \"echo\")\n\n    assert {:error, {:unsupported_capability, :drain}} =\n             Gaoxy.add(\n               runtime,\n               Map.merge(hd(services), %{id: \"strong-drain\", capabilities: [:drain]})\n             )\n\n    peer(echo, directory, \"echo\")\n\n    assert_receive {:bounds, {:error, :output_limit}, {:error, :invalid_read_limit},\n                    {:error, :invalid_operation_options}},\n                   2000\n\n    assert_receive {:after_fin, \"after-server-fin\"}, 2000\n    assert_receive {:flow_control, {:blocked, _}}, 2000\n    assert_receive {:write, operation, status}, 2000\n    assert is_reference(operation)\n    IO.inspect(status, label: \"QUIC_NATIVE_OPERATION_STATUS\")\n    peer(echo, directory, \"isolation\")\n    peer(controls, directory, \"controls\")\n    assert_receive {:reset_result, {:ok, reset}}, 2000\n    assert_receive {:stop_result, {:ok, stop}}, 2000\n    assert is_reference(reset) and is_reference(stop)\n    peer(echo, directory, \"negative\", \"gaoxy-unsupported-v1\")\n    wrong = Path.join(directory, \"wrong-ca\")\n    {_, 0} = System.cmd(\"bash\", [\"../../scripts/generate-fixtures.sh\", wrong])\n    peer(echo, wrong, \"negative\")\n\n    {:ok, {ip, port}} = Gaoxy.info(runtime, \"tcp\").local\n    {:ok, socket} = :gen_tcp.connect(ip, port, [:binary, active: false], 2000)\n    :ok = :gen_tcp.send(socket, \"quic-independent-sibling\")\n    assert {:ok, \"quic-independent-sibling\"} = :gen_tcp.recv(socket, 0, 2000)\n    :gen_tcp.close(socket)\n    assert %{retained_high_water: high} = Gaoxy.status(runtime, \"echo\")\n    assert high <= 262_144\n    :ok = Gaoxy.remove(runtime, \"echo\", 1000)\n    assert \"echo\" not in Gaoxy.services(runtime)\n    IO.puts(\"PASS QUIC_FACADE_WIRE_BOUNDS_LIFECYCLE\")\n  end\n\n  defp peer(port, directory, mode, alpn \\\\ \"gaoxy-stream-v1\") do\n    {output, exit} =\n      System.cmd(\n        \"uv\",\n        [\n          \"run\",\n          \"--python\",\n          \"3.12\",\n          \"--with\",\n          \"aioquic==1.2.0\",\n          \"python\",\n          \"peer.py\",\n          \"--port\",\n          Integer.to_string(port),\n          \"--ca\",\n          Path.join(directory, \"ca.pem\"),\n          \"--mode\",\n          mode,\n          \"--alpn\",\n          alpn\n        ],\n        stderr_to_stdout: true\n      )\n\n    IO.write(output)\n    assert exit == 0, \"independent #{mode} peer exit #{exit}\"\n    assert output =~ \"\\\"result\\\": \\\"PASS\\\"\"\n  end\nend\n",
  "integration/quic_consumer/peer.py": "#!/usr/bin/env python3\n\"\"\"Independent, certificate-validating aioquic 1.2.0 application peer.\"\"\"\nimport argparse\nimport asyncio\nimport json\n\nfrom aioquic.asyncio import connect\nfrom aioquic.asyncio.protocol import QuicConnectionProtocol\nfrom aioquic.quic.configuration import QuicConfiguration\nfrom aioquic.quic.events import (\n    ConnectionTerminated, StopSendingReceived, StreamDataReceived, StreamReset,\n)\n\n\nclass Peer(QuicConnectionProtocol):\n    def __init__(self, *args, **kwargs):\n        super().__init__(*args, **kwargs)\n        self.data, self.fins, self.resets, self.stops = {}, set(), {}, {}\n        self.terminated = None\n        self.changed = asyncio.Event()\n\n    def quic_event_received(self, event):\n        if isinstance(event, StreamDataReceived):\n            sid = event.stream_id\n            self.data[sid] = self.data.get(sid, b\"\") + event.data\n            if event.end_stream:\n                self.fins.add(sid)\n                # A server bidi FIN only closes its sending direction.\n                if sid == 1:\n                    self._quic.send_stream_data(sid, b\"after-server-fin\", end_stream=True)\n                    self.transmit()\n        elif isinstance(event, StreamReset):\n            self.resets[event.stream_id] = event.error_code\n        elif isinstance(event, StopSendingReceived):\n            self.stops[event.stream_id] = event.error_code\n        elif isinstance(event, ConnectionTerminated):\n            self.terminated = event.error_code\n        self.changed.set()\n\n    async def until(self, predicate):\n        async with asyncio.timeout(15):\n            while not predicate():\n                assert self.terminated is None, (self.terminated, self.data, self.fins)\n                self.changed.clear()\n                await self.changed.wait()\n\n    def send(self, sid, data, fin=True):\n        self._quic.send_stream_data(sid, data, end_stream=fin)\n        self.transmit()\n\n\nasync def exchange(peer, value):\n    peer.send(0, value)\n    await peer.until(lambda: 0 in peer.fins and 1 in peer.fins)\n    assert peer.data[0] == value\n    assert peer.data[1] == b\"server-fin\"\n\n\nasync def run(args):\n    config = QuicConfiguration(\n        is_client=True, alpn_protocols=[args.alpn], max_data=4096,\n        max_stream_data=2048, idle_timeout=20,\n    )\n    config.server_name = \"localhost\"\n    config.load_verify_locations(args.ca)\n    async with connect(\"127.0.0.1\", args.port, configuration=config, create_protocol=Peer) as peer:\n        if args.mode == \"echo\":\n            await exchange(peer, b\"bounded-gaoxy-stream-\" * 16384)\n            peer.send(4, b\"second-stream\")\n            await peer.until(lambda: 4 in peer.fins)\n            assert peer.data[4] == b\"second-stream\"\n            print(json.dumps({\"result\": \"PASS\", \"gate\": \"stream_flow_control_fin\",\n                              \"bytes\": len(peer.data[0]), \"streams\": 3}), flush=True)\n        elif args.mode == \"isolation\":\n            async with connect(\"127.0.0.1\", args.port, configuration=config, create_protocol=Peer) as sibling:\n                peer.close(error_code=0x9876, reason_phrase=\"one connection\")\n                await asyncio.wait_for(peer.wait_closed(), 5)\n                await exchange(sibling, b\"surviving-connection-\" * 4096)\n                print(json.dumps({\"result\": \"PASS\", \"gate\": \"connection_close_isolation\",\n                                  \"bytes\": len(sibling.data[0])}), flush=True)\n        elif args.mode == \"controls\":\n            peer.send(0, b\"reset\", False)\n            peer.send(4, b\"stop\", False)\n            await peer.until(lambda: 0 in peer.resets and 4 in peer.stops)\n            assert peer.resets[0] == 0x12345\n            assert peer.stops[4] == 0x54321\n            print(json.dumps({\"result\": \"PASS\", \"gate\": \"directional_reset_stop\",\n                              \"reset\": peer.resets[0], \"stop\": peer.stops[4]}), flush=True)\n        elif args.mode == \"negative\":\n            raise AssertionError(\"unsupported ALPN / untrusted CA unexpectedly connected\")\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--port\", required=True, type=int)\n    parser.add_argument(\"--ca\", required=True)\n    parser.add_argument(\"--alpn\", default=\"gaoxy-stream-v1\")\n    parser.add_argument(\"--mode\", required=True, choices=[\"echo\", \"isolation\", \"controls\", \"negative\"])\n    args = parser.parse_args()\n    try:\n        asyncio.run(run(args))\n    except ConnectionError:\n        if args.mode != \"negative\":\n            raise\n        print(json.dumps({\"result\": \"PASS\", \"gate\": \"handshake_rejected\", \"alpn\": args.alpn}), flush=True)\n\n\nif __name__ == \"__main__\":\n    main()\n"
}
