+  # Public read arguments/results only; never retain Exchange, socket or body bytes.
+  defp observe_ingress(table, owners, owner, direction, module, operation, value, timestamp) do
+    if owners[owner] == "h1-tiny_window_1mib" and
+         {module, operation} in [{Gaoxy.HTTP.Exchange, :read_body_step}, {ThousandIsland.Socket, :recv}] do
+      at = trace_us(timestamp)
+      key = {:matrix_ingress_call, owner, operation}
+
+      event =
+        case {direction, operation, value} do
+          {:call, :read_body_step, [exchange, credit, wait]} ->
+            event = %{kind: "call", operation: "read_body_step", at_us: at,
+                      phase: read_phase(exchange), credit: credit, wait_ms: wait}
+
+            event =
+              case Process.delete({:matrix_ingress_reply, owner}) do
+                nil -> event
+                replied -> Map.put(event, :reply_to_read_us, at - replied)
+              end
+
+            Process.put(key, event)
+            event
+
+          {:call, :recv, [_, size, timeout]} ->
+            # Label the enclosing step's entry phase, not private decoder progress.
+            step = Process.get({:matrix_ingress_call, owner, :read_body_step}, %{})
+            event = %{kind: "call", operation: "recv", at_us: at,
+                      phase: Map.get(step, :phase, "outside_step"), size: size, wait_ms: timeout}
+            Process.put(key, event)
+            event
+
+          {:return, _, result} ->
+            case Process.delete(key) do
+              nil -> nil
+              started ->
+                event = Map.merge(started, %{kind: "return", at_us: at, duration_us: at - started.at_us,
+                                            category: read_category(result), bytes: read_bytes(result)})
+                if operation == :read_body_step, do: Map.put(event, :end_phase, read_return_phase(result)), else: event
+            end
+
+          _ -> nil
+        end
+
+      if event do
+        update(table, owners[owner], fn receipt ->
+          trace = Map.get(receipt, :ingress_trace, %{counts: %{}, metrics: %{}, first: [], last: [], body_bytes: 0, recv_bytes: 0})
+          size = if event.operation == "recv", do: if(event.size == 1, do: ":one_byte", else: ":bulk"), else: ""
+          name = event.kind <> ":" <> event.operation <> ":" <> event.phase <> size <> ":" <> Map.get(event, :category, "")
+          metrics = if Map.has_key?(event, :duration_us),
+            do: Map.update(trace.metrics, name, measurement(event.duration_us), &measure(&1, event.duration_us)),
+            else: trace.metrics
+          metrics = if Map.has_key?(event, :reply_to_read_us),
+            do: Map.update(metrics, "reply_to_read_us", measurement(event.reply_to_read_us), &measure(&1, event.reply_to_read_us)),
+            else: metrics
+          metric_name = if event.operation == "recv", do: :recv_bytes, else: :body_bytes
+          trace = Map.update!(trace, metric_name, &(&1 + Map.get(event, :bytes, 0)))
+          Map.put(receipt, :ingress_trace, %{trace |
+            counts: Map.update(trace.counts, name, 1, &(&1 + 1)), metrics: metrics,
+            first: if(length(trace.first) < 8, do: trace.first ++ [event], else: trace.first),
+            last: Enum.take(trace.last ++ [event], -8)})
+        end)
+      end
+    end
+  end
