+  defp settle_stream_resources(state, ref) do
+    lease = state.leases[ref]
+
+    cond do
+      not stream_membership?(lease.accounting) ->
+        terminal_result(release_lease(state, ref))
+
+      lease.bytes == 0 ->
+        state
+
+      true ->
+        accounting = %{
+          lease.accounting
+          | retained_bytes: 0,
+            temporary_bytes: 0,
+            transport_bytes: 0,
+            websocket_bytes: 0,
+            pending_processes: 0
+        }
+
+        commit = fn state, receipt, _ ->
