{<<"links">>,
 [{<<"GitHub">>,<<"https://github.com/gsmlg-dev/gaoxy">>},
  {<<"Upstream">>,<<"https://github.com/phoenixframework/websock_adapter">>}]}.
{<<"name">>,<<"gaoxy_websock_adapter">>}.
{<<"version">>,<<"0.5.2">>}.
{<<"description">>,
 <<"Gaoxy distribution of WebSockAdapter with native HTTP/2 and HTTP/3 support">>}.
{<<"elixir">>,<<"~> 1.9">>}.
{<<"app">>,<<"websock_adapter">>}.
{<<"licenses">>,[<<"MIT">>]}.
{<<"files">>,
 [<<"CHANGELOG.md">>,<<"GAOXY.md">>,<<"LICENSE">>,<<"LICENSE.gaoxy">>,
  <<"README.md">>,<<"SOURCE.json">>,<<"gaoxy.patch">>,<<"lib">>,
  <<"lib/websock_adapter.ex">>,<<"lib/websock_adapter">>,
  <<"lib/websock_adapter/upgrade_validation.ex">>,
  <<"lib/websock_adapter/upgrade_error.ex">>,
  <<"lib/websock_adapter/cowboy_adapter.ex">>,<<"mix.exs">>]}.
{<<"requirements">>,
 [[{<<"name">>,<<"websock">>},
   {<<"app">>,<<"websock">>},
   {<<"optional">>,false},
   {<<"requirement">>,<<"~> 0.5">>},
   {<<"repository">>,<<"hexpm">>}],
  [{<<"name">>,<<"plug">>},
   {<<"app">>,<<"plug">>},
   {<<"optional">>,false},
   {<<"requirement">>,<<"~> 1.14">>},
   {<<"repository">>,<<"hexpm">>}],
  [{<<"name">>,<<"bandit">>},
   {<<"app">>,<<"bandit">>},
   {<<"optional">>,true},
   {<<"requirement">>,<<">= 0.6.0">>},
   {<<"repository">>,<<"hexpm">>}],
  [{<<"name">>,<<"plug_cowboy">>},
   {<<"app">>,<<"plug_cowboy">>},
   {<<"optional">>,true},
   {<<"requirement">>,<<"~> 2.6">>},
   {<<"repository">>,<<"hexpm">>}]]}.
{<<"build_tools">>,[<<"mix">>]}.
