defmodule SendTimingProbe do
  def init(_, options), do: {:ok, options}
  def handle_data(_, %{owner: owner, size: size} = state) do
    started = System.monotonic_time(:microsecond)
    send(owner, {:copy_started, self(), started})
    bytes = :binary.copy("x", size)
    send(owner, {:copy_finished, self(), System.monotonic_time(:microsecond), byte_size(bytes)})
    {:send, bytes, state}
  end
  def collect(client, worker, events, finish) do
    remaining = max(0, finish - System.monotonic_time(:millisecond))
    receive do
      {:copy_started, pid, at} = event ->
        Process.monitor(pid)
        collect(client, pid, [{event, System.monotonic_time(:microsecond)} | events], finish)
      {:copy_finished, _, _, _} = event ->
        collect(client, worker, [event | events], finish)
      {:probe_event, [:gaoxy, :send], at, %{outcome: :ok}} = event ->
        :ok = :gen_tcp.send(client, "again")
        collect(client, worker, [event | events], finish)
      {:probe_event, _, _, _} = event ->
        collect(client, worker, [event | events], finish)
      {:DOWN, _, :process, ^worker, reason} ->
        Enum.reverse([{:down, System.monotonic_time(:microsecond), reason} | events])
    after
      min(20, remaining) ->
        if remaining == 0 do
          Enum.reverse([:probe_deadline | events])
        else
          sample = if worker, do: Process.info(worker, [:current_function, :current_stacktrace, :status])
          collect(client, worker, [{:sample, System.monotonic_time(:microsecond), sample} | events], finish)
        end
    end
  end
end
for iteration <- 1..5 do
  {:ok, instance} = Gaoxy.start_link(services: [%{id: "blocked", transport: :tcp, handler: SendTimingProbe, handler_options: %{owner: self(), size: 16 * 1_048_576}, limits: %{max_active: 1, max_output: 16 * 1_048_576, max_bytes: 16 * 1_048_576 + 65_536, callback_timeout: 500}}])
  %{generation: generation, local: {:ok, {ip, port}}} = Gaoxy.info(instance, "blocked")
  owner = self()
  reference = make_ref()
  :telemetry.attach_many(reference, [[:gaoxy, :work], [:gaoxy, :timeout], [:gaoxy, :send_started], [:gaoxy, :send]], fn event, measurements, metadata, _ ->
    if metadata.generation == generation, do: send(owner, {:probe_event, event, System.monotonic_time(:microsecond), Map.merge(measurements, metadata)})
  end, nil)
  {:ok, client} = :gen_tcp.connect(ip, port, [:binary, active: false, recbuf: 1_024])
  :ok = :gen_tcp.send(client, "begin")
  events = SendTimingProbe.collect(client, nil, [], System.monotonic_time(:millisecond) + 3_000)
  IO.inspect(events, label: "iteration #{iteration}", limit: :infinity, printable_limit: :infinity)
  :telemetry.detach(reference)
  :gen_tcp.close(client)
  Gaoxy.stop(instance, 0)
end

