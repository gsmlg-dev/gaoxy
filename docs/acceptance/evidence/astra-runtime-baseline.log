{
  "apps/gaoxy/lib/gaoxy.ex": "defmodule Gaoxy do\n  @moduledoc \"Embedded multi-instance transport runtime. Service IDs are scoped to the returned instance PID.\"\n  def start_link(options \\\\ []) do\n    with {:ok, plan} <- Gaoxy.Config.validate(options), do: Gaoxy.Instance.start_link(plan)\n  end\n\n  def child_spec(options),\n    do: %{\n      id: {__MODULE__, make_ref()},\n      start: {__MODULE__, :start_link, [options]},\n      restart: :transient\n    }\n\n  def add(instance, spec), do: GenServer.call(instance, {:add, spec}, :infinity)\n  def services(instance), do: GenServer.call(instance, :services)\n  def handle(instance, id), do: service_call(instance, id, :handle)\n  def info(instance, id), do: service_call(instance, id, :info)\n  def status(instance, id), do: service_call(instance, id, :status)\n  def pause(instance, id), do: service_call(instance, id, :pause)\n  def resume(instance, id), do: service_call(instance, id, :resume)\n  def memberships(instance, id), do: service_call(instance, id, :memberships)\n\n  def join(instance, id, membership),\n    do: service_call(instance, id, {:membership, :join, membership})\n\n  def leave(instance, id, membership),\n    do: service_call(instance, id, {:membership, :leave, membership})\n\n  def remove(instance, id, timeout \\\\ 5_000) when is_integer(timeout) and timeout >= 0 do\n    with {:ok, pid, generation} <- GenServer.call(instance, {:lookup, id}),\n         :ok <- GenServer.call(pid, {:drain, generation, timeout}, :infinity) do\n      GenServer.call(instance, {:remove, id, pid}, :infinity)\n    end\n  end\n\n  def stop(instance, timeout \\\\ 5_000) do\n    deadline = System.monotonic_time(:millisecond) + timeout\n\n    for id <- services(instance) do\n      remove(instance, id, max(0, deadline - System.monotonic_time(:millisecond)))\n    end\n\n    GenServer.stop(instance, :normal)\n  end\n\n  def capabilities do\n    %{\n      tcp: :supported,\n      tls_otp: :supported,\n      udp_unicast: :supported,\n      udp_broadcast_ipv4: :supported,\n      udp_multicast_ipv4: :supported,\n      udp_multicast_ipv6: if(:os.type() == {:unix, :linux}, do: :not_tested, else: :unsupported),\n      tls_ex_ssl: :unsupported,\n      quic: :unsupported,\n      http: :unsupported,\n      mtls: :unsupported,\n      metadata_destination: :not_tested\n    }\n  end\n\n  defp service_call(instance, id, request) do\n    with {:ok, pid, generation} <- GenServer.call(instance, {:lookup, id}) do\n      GenServer.call(pid, {:request, generation, request})\n    end\n  catch\n    :exit, {:noproc, _} -> {:error, :not_running}\n  end\nend\n",
  "apps/gaoxy/lib/gaoxy/telemetry.ex": "defmodule Gaoxy.Telemetry do\n  @moduledoc false\n  def emit(event, measurements, scope, metadata \\\\ %{}) do\n    :telemetry.execute([:gaoxy, event], measurements, Map.merge(scope, metadata))\n  end\nend\n",
  "apps/gaoxy/lib/gaoxy/instance.ex": "defmodule Gaoxy.Instance do\n  @moduledoc false\n  use GenServer\n\n  def start_link(plan) do\n    case GenServer.start(\n           __MODULE__,\n           {plan, self()},\n           if(plan.name, do: [name: plan.name], else: [])\n         ) do\n      {:ok, pid} = result ->\n        Process.link(pid)\n        result\n\n      error ->\n        error\n    end\n  end\n\n  @impl true\n  def init({plan, parent}) do\n    Process.flag(:trap_exit, true)\n    table = :ets.new(__MODULE__, [:set, :public])\n    {:ok, supervisor} = DynamicSupervisor.start_link(strategy: :one_for_one)\n\n    state = %{\n      table: table,\n      supervisor: supervisor,\n      scope: make_ref(),\n      parent: parent,\n      parent_monitor: Process.monitor(parent)\n    }\n\n    case Enum.reduce_while(plan.services, :ok, fn spec, _ ->\n           case start_service(spec, state) do\n             {:ok, _} -> {:cont, :ok}\n             {:error, reason} -> {:halt, {:error, reason}}\n           end\n         end) do\n      :ok ->\n        {:ok, state}\n\n      {:error, reason} ->\n        Supervisor.stop(supervisor)\n        {:stop, reason}\n    end\n  end\n\n  @impl true\n  def handle_call(:services, _, state),\n    do: {:reply, Enum.map(:ets.tab2list(state.table), &elem(&1, 0)), state}\n\n  def handle_call({:lookup, id}, _, state) do\n    {id, expected} =\n      case id do\n        %{id: id, generation: generation} -> {id, generation}\n        id -> {id, nil}\n      end\n\n    result =\n      case Registry.lookup(Gaoxy.Registry, {state.scope, id}) do\n        [{pid, generation}] when is_nil(expected) or expected == generation ->\n          {:ok, pid, generation}\n\n        [_] ->\n          {:error, :stale_generation}\n\n        [] ->\n          {:error, :not_running}\n      end\n\n    {:reply, result, state}\n  end\n\n  def handle_call({:add, input}, _, state) do\n    result =\n      with {:ok, plan} <-\n             Gaoxy.Config.validate(\n               services: [input | Enum.map(:ets.tab2list(state.table), &elem(&1, 1))]\n             ) do\n        start_service(hd(plan.services), state)\n      end\n\n    {:reply, result, state}\n  end\n\n  def handle_call({:remove, id, pid}, _, state) do\n    id = if is_map(id), do: id.id, else: id\n\n    case Registry.lookup(Gaoxy.Registry, {state.scope, id}) do\n      [{^pid, _}] ->\n        :ok = DynamicSupervisor.terminate_child(state.supervisor, pid)\n        :ets.delete(state.table, id)\n        {:reply, :ok, state}\n\n      _ ->\n        {:reply, {:error, :stale_generation}, state}\n    end\n  end\n\n  @impl true\n  def handle_info({:EXIT, pid, reason}, %{supervisor: pid} = state), do: {:stop, reason, state}\n  def handle_info({:EXIT, pid, reason}, %{parent: pid} = state), do: {:stop, reason, state}\n\n  def handle_info({:DOWN, ref, :process, _, reason}, %{parent_monitor: ref} = state),\n    do: {:stop, reason, state}\n\n  def handle_info(_, state), do: {:noreply, state}\n  @impl true\n  def terminate(_, state),\n    do: if(Process.alive?(state.supervisor), do: Supervisor.stop(state.supervisor))\n\n  defp start_service(spec, state) do\n    :ets.insert(state.table, {spec.id, spec})\n\n    case DynamicSupervisor.start_child(\n           state.supervisor,\n           {Gaoxy.Service, {state.table, spec.id, state.scope}}\n         ) do\n      {:ok, pid} ->\n        {:ok, GenServer.call(pid, {:request, nil, :handle})}\n\n      {:error, reason} ->\n        :ets.delete(state.table, spec.id)\n        {:error, reason}\n    end\n  end\nend\n",
  "apps/gaoxy/lib/gaoxy/service.ex": "defmodule Gaoxy.Service do\n  @moduledoc false\n  use GenServer, restart: :transient\n  alias Gaoxy.{Admission, Telemetry}\n  def start_link(args), do: GenServer.start_link(__MODULE__, args)\n\n  @impl true\n  def init({table, id, instance}) do\n    Process.flag(:trap_exit, true)\n    [{^id, spec}] = :ets.lookup(table, id)\n    generation = make_ref()\n    scope = %{instance: instance, service: id, generation: generation}\n    {:ok, _} = Registry.register(Gaoxy.Registry, {instance, id}, generation)\n    {:ok, gate} = Admission.start_link({spec.limits, scope})\n    context = %{spec: spec, gate: gate, scope: scope}\n\n    result =\n      try do\n        start_backend(spec, context)\n      rescue\n        error -> {:error, {:backend_configuration, error.__struct__}}\n      catch\n        :exit, reason -> {:error, {:backend_start, reason}}\n      end\n\n    case result do\n      {:ok, backend} ->\n        Telemetry.emit(:lifecycle, %{count: 1}, scope, %{state: :ready})\n\n        {:ok,\n         %{\n           spec: spec,\n           table: table,\n           backend: backend,\n           gate: gate,\n           scope: scope,\n           generation: generation,\n           mode: :ready,\n           drain: nil\n         }}\n\n      {:error, reason} ->\n        GenServer.stop(gate)\n        {:stop, reason}\n    end\n  end\n\n  @impl true\n  def handle_call({:request, generation, _}, _, state)\n      when not is_nil(generation) and generation != state.generation,\n      do: {:reply, {:error, :stale_generation}, state}\n\n  def handle_call({:request, _, :handle}, _, state),\n    do: {:reply, %{id: state.spec.id, generation: state.generation}, state}\n\n  def handle_call({:request, _, :info}, _, state),\n    do:\n      {:reply,\n       %{\n         id: state.spec.id,\n         generation: state.generation,\n         transport: state.spec.transport,\n         mode: state.mode,\n         local: local(state),\n         pause: if(state.spec.transport == :udp, do: :admission_only, else: :unbind_rebind)\n       }, state}\n\n  def handle_call({:request, _, :status}, _, state),\n    do:\n      {:reply,\n       Map.merge(Admission.status(state.gate), %{\n         state: state.mode,\n         backend: backend_status(state)\n       }), state}\n\n  def handle_call({:request, _, operation}, _, %{mode: mode} = state)\n      when operation in [:pause, :resume] and mode in [:draining, :stopped],\n      do: {:reply, {:error, mode}, state}\n\n  def handle_call({:request, _, :pause}, _, state) do\n    :ok = Admission.mode(state.gate, :paused)\n\n    case host(state).suspend(state.backend) do\n      :ok -> {:reply, :ok, transition(state, :paused)}\n      error -> {:reply, error, state}\n    end\n  end\n\n  def handle_call({:request, _, :resume}, _, state) do\n    case host(state).resume(state.backend) do\n      :ok ->\n        Admission.mode(state.gate, :ready)\n        {:reply, :ok, transition(state, :ready)}\n\n      error ->\n        {:reply, error, state}\n    end\n  end\n\n  def handle_call({:request, _, :memberships}, _, state),\n    do: {:reply, membership_list(state), state}\n\n  def handle_call({:request, _, {:membership, operation, membership}}, _, state) do\n    result = membership_change(state, operation, membership)\n\n    if result == :ok do\n      spec = put_in(state.spec.udp[:memberships], Abyss.memberships(state.backend))\n      :ets.insert(state.table, {spec.id, spec})\n      {:reply, :ok, %{state | spec: spec}}\n    else\n      {:reply, result, state}\n    end\n  end\n\n  def handle_call({:drain, generation, timeout}, from, state)\n      when generation == state.generation and is_nil(state.drain) do\n    :ok = Admission.mode(state.gate, :draining)\n    deadline = System.monotonic_time(:millisecond) + timeout\n    owner = self()\n    backend = state.backend\n    host = host(state)\n    # Only control work is spawned. Datagram processing never creates rejected-work tasks.\n    {pid, monitor} =\n      spawn_monitor(fn ->\n        result =\n          if host == Abyss do\n            Abyss.stop(backend, max(0, deadline - System.monotonic_time(:millisecond)))\n          else\n            ThousandIsland.suspend(backend)\n            send(owner, {:tcp_admission_stopped, self()})\n\n            receive do\n              :close_backend -> Supervisor.stop(backend, :normal, :infinity)\n            end\n          end\n\n        send(owner, {:drained, self(), result})\n      end)\n\n    token = make_ref()\n    timer = Process.send_after(self(), {:drain_deadline, token}, timeout)\n    if host != Abyss, do: send(self(), :check_drain)\n\n    drain = %{\n      pid: pid,\n      monitor: monitor,\n      from: from,\n      timer: timer,\n      token: token,\n      deadline: deadline\n    }\n\n    {:noreply, %{transition(state, :draining) | drain: drain}}\n  end\n\n  def handle_call({:drain, _, _}, _, state),\n    do: {:reply, {:error, :already_draining_or_stale}, state}\n\n  @impl true\n  def handle_info(:check_drain, %{drain: nil} = state), do: {:noreply, state}\n\n  def handle_info(:check_drain, state) do\n    if Admission.status(state.gate).active == 0 do\n      send(state.drain.pid, :close_backend)\n    else\n      Process.send_after(self(), :check_drain, 5)\n    end\n\n    {:noreply, state}\n  end\n\n  def handle_info({:drained, pid, :ok}, %{drain: %{pid: pid}} = state),\n    do: finish_drain(state, :completed)\n\n  def handle_info({:drain_deadline, token}, %{drain: %{token: token}} = state) do\n    Process.exit(state.backend, :kill)\n    Process.exit(state.drain.pid, :kill)\n    finish_drain(state, :forced)\n  end\n\n  def handle_info({:EXIT, pid, _}, %{backend: pid, mode: mode} = state)\n      when mode in [:draining, :stopped], do: {:noreply, state}\n\n  def handle_info({:EXIT, pid, reason}, state) when pid == state.backend or pid == state.gate,\n    do: {:stop, {:backend_failed, reason}, state}\n\n  def handle_info({:DOWN, monitor, :process, _pid, reason}, %{drain: %{monitor: monitor}} = state)\n      when reason != :normal,\n      do: finish_drain(state, {:cleanup_error, reason})\n\n  def handle_info(_, state), do: {:noreply, state}\n  @impl true\n  def terminate(_, state) do\n    if state.drain, do: Process.exit(state.drain.pid, :kill)\n    if Process.alive?(state.gate), do: GenServer.stop(state.gate)\n\n    if Process.alive?(state.backend) do\n      try do\n        Supervisor.stop(state.backend, :normal, 1_000)\n      catch\n        :exit, _ -> Process.exit(state.backend, :kill)\n      end\n    end\n  end\n\n  defp finish_drain(state, outcome) do\n    Process.cancel_timer(state.drain.timer)\n    GenServer.reply(state.drain.from, :ok)\n    Telemetry.emit(:drain, %{count: 1}, state.scope, %{outcome: outcome})\n    {:noreply, %{transition(state, :stopped) | drain: nil}}\n  end\n\n  defp transition(state, mode) do\n    Telemetry.emit(:lifecycle, %{count: 1}, state.scope, %{state: mode})\n    %{state | mode: mode}\n  end\n\n  defp host(%{spec: %{transport: :udp}}), do: Abyss\n  defp host(_), do: ThousandIsland\n  defp local(%{mode: :stopped}), do: {:error, :stopped}\n\n  defp local(%{spec: %{transport: :udp}} = state) do\n    case Abyss.Listener.for_server(state.backend) do\n      [listener] -> Abyss.Listener.listener_info(listener)\n      _ -> {:error, :not_ready}\n    end\n  end\n\n  defp local(state), do: ThousandIsland.listener_info(state.backend)\n  defp backend_status(%{mode: :stopped}), do: :stopped\n\n  defp backend_status(%{spec: %{transport: :udp}} = state) do\n    case Abyss.Listener.for_server(state.backend) do\n      [listener] -> Abyss.Listener.status(listener)\n      _ -> :not_ready\n    end\n  end\n\n  defp backend_status(_), do: :stream\n\n  defp membership_list(%{spec: %{transport: :udp, mode: :multicast}} = state),\n    do: Abyss.memberships(state.backend)\n\n  defp membership_list(_), do: {:error, {:unsupported_capability, :memberships}}\n\n  defp membership_change(\n         %{spec: %{transport: :udp, mode: :multicast}, mode: mode} = state,\n         operation,\n         membership\n       )\n       when mode in [:ready, :paused] do\n    with true <-\n           Gaoxy.Config.valid_membership?(membership, state.spec.ip) ||\n             {:error, :invalid_membership},\n         {:ok, canonical} <- Abyss.Transport.UDP.Multicast.normalize_membership(membership) do\n      current = Abyss.memberships(state.backend)\n\n      if operation == :join and canonical not in current and\n           length(current) >= state.spec.limits.max_memberships do\n        {:error, :membership_limit}\n      else\n        apply(Abyss, operation, [state.backend, membership])\n      end\n    end\n  end\n\n  defp membership_change(_, _, _), do: {:error, {:unsupported_capability, :memberships}}\n\n  defp start_backend(%{transport: :udp} = spec, context) do\n    transport =\n      case spec.mode do\n        :unicast -> Abyss.Transport.UDP.Unicast\n        :broadcast -> Abyss.Transport.UDP.Broadcast\n        :multicast -> Abyss.Transport.UDP.Multicast\n      end\n\n    options =\n      Enum.map(Map.get(spec.udp, :memberships, []), &{:add_membership, &1}) ++\n        Map.to_list(Map.drop(spec.udp, [:memberships, :inet_backend]))\n\n    options = [\n      {:inet_backend, Map.get(spec.udp, :inet_backend, :inet)},\n      if(tuple_size(spec.ip) == 8, do: :inet6, else: :inet),\n      {:ip, spec.ip} | options\n    ]\n\n    Abyss.start_link(\n      handler_module: Gaoxy.DatagramBridge,\n      handler_options: context,\n      port: spec.port,\n      transport_module: transport,\n      transport_options: options,\n      num_listeners: 1,\n      num_connections: spec.limits.max_active,\n      max_packet_size: spec.limits.max_packet,\n      admission_start_timeout: spec.limits.callback_timeout,\n      read_timeout: spec.limits.idle_timeout,\n      shutdown_timeout: spec.limits.drain_timeout,\n      connection_telemetry_sample_rate: 1.0\n    )\n  end\n\n  defp start_backend(spec, context) do\n    tls =\n      if spec.transport == :tls do\n        [\n          certfile: spec.tls.certfile,\n          keyfile: spec.tls.keyfile,\n          versions: Map.get(spec.tls, :versions, [:\"tlsv1.3\"]),\n          alpn_preferred_protocols: Map.get(spec.tls, :alpn, [])\n        ]\n      else\n        []\n      end\n\n    ThousandIsland.start_link(\n      handler_module: Gaoxy.StreamBridge,\n      handler_options: context,\n      port: spec.port,\n      transport_module:\n        if(spec.transport == :tls,\n          do: ThousandIsland.Transports.SSL,\n          else: ThousandIsland.Transports.TCP\n        ),\n      transport_options: [\n        if(tuple_size(spec.ip) == 8, do: :inet6, else: :inet),\n        {:ip, spec.ip},\n        {:send_timeout, spec.limits.callback_timeout},\n        {:send_timeout_close, true} | tls\n      ],\n      num_acceptors: 1,\n      num_connections: spec.limits.max_active,\n      max_connections_retry_count: 0,\n      read_timeout: spec.limits.idle_timeout,\n      handshake_timeout: spec.limits.callback_timeout,\n      shutdown_timeout: spec.limits.drain_timeout\n    )\n  end\nend\n",
  "apps/gaoxy/lib/gaoxy/config.ex": "defmodule Gaoxy.Config do\n  @moduledoc \"Pure, strict validation of trusted embedded specifications. No sockets are opened.\"\n  @limits %{\n    max_active: 64,\n    max_bytes: 1_048_576,\n    max_packet: 65_507,\n    max_output: 65_507,\n    max_state: 65_536,\n    callback_timeout: 5_000,\n    idle_timeout: 30_000,\n    drain_timeout: 5_000,\n    max_memberships: 64\n  }\n  @keys [\n    :id,\n    :transport,\n    :handler,\n    :handler_options,\n    :ip,\n    :port,\n    :mode,\n    :tls,\n    :udp,\n    :limits,\n    :capabilities\n  ]\n\n  def validate(options) do\n    with :ok <- keyword(options),\n         :ok <- known(Map.new(options), [:services, :name]),\n         true <- is_list(Keyword.get(options, :services, [])) || {:error, :invalid_services},\n         {:ok, services} <- services(Keyword.get(options, :services, []), []) do\n      {:ok, %{name: Keyword.get(options, :name), services: services}}\n    end\n  end\n\n  def service(input) when is_map(input) do\n    limits = Map.merge(@limits, Map.get(input, :limits, %{}))\n\n    spec =\n      Map.merge(\n        %{\n          ip: {127, 0, 0, 1},\n          port: 0,\n          mode: :unicast,\n          tls: %{},\n          udp: %{},\n          handler_options: [],\n          capabilities: []\n        },\n        input\n      )\n      |> Map.put(:limits, limits)\n\n    with :ok <- known(input, @keys),\n         :ok <- identity(spec),\n         :ok <- limit_check(input, limits),\n         :ok <- transport(spec),\n         :ok <- handler(spec),\n         :ok <- requested(spec) do\n      {:ok, spec}\n    end\n  rescue\n    BadMapError -> {:error, :invalid_options}\n    ArgumentError -> {:error, :invalid_options}\n  end\n\n  def service(_), do: {:error, :invalid_service}\n\n  def conflicts(a, b) do\n    family = fn spec -> if spec.transport == :udp, do: :udp, else: :tcp end\n\n    a.port != 0 and a.port == b.port and family.(a) == family.(b) and\n      tuple_size(a.ip) == tuple_size(b.ip) and\n      (a.ip == b.ip or wildcard?(a.ip) or wildcard?(b.ip))\n  end\n\n  defp services([], acc), do: {:ok, Enum.reverse(acc)}\n\n  defp services([input | rest], acc) do\n    with {:ok, spec} <- service(input), :ok <- unique(spec, acc) do\n      services(rest, [spec | acc])\n    end\n  end\n\n  defp unique(spec, existing) do\n    cond do\n      Enum.any?(existing, &(&1.id == spec.id)) ->\n        {:error, {:duplicate_service, spec.id}}\n\n      conflict = Enum.find(existing, &conflicts(&1, spec)) ->\n        {:error, {:binding_conflict, spec.id, conflict.id}}\n\n      true ->\n        :ok\n    end\n  end\n\n  defp keyword(options) do\n    if Keyword.keyword?(options) and length(options) == map_size(Map.new(options)),\n      do: :ok,\n      else: {:error, :invalid_options}\n  end\n\n  defp known(options, keys) when is_map(options) do\n    case Map.keys(options) -- keys do\n      [] -> :ok\n      unknown -> {:error, {:unknown_options, Enum.sort(unknown)}}\n    end\n  end\n\n  defp known(_, _), do: {:error, :invalid_options}\n\n  defp identity(%{id: id, ip: ip, port: port}) do\n    if ((is_atom(id) and not is_nil(id)) or (is_binary(id) and byte_size(id) in 1..128)) and\n         valid_ip?(ip) and is_integer(port) and port in 0..65_535,\n       do: :ok,\n       else: {:error, :invalid_identity_or_binding}\n  end\n\n  defp identity(_), do: {:error, :missing_identity}\n\n  defp valid_ip?(ip) when is_tuple(ip) and tuple_size(ip) in [4, 8] do\n    max = if tuple_size(ip) == 4, do: 255, else: 65_535\n    Enum.all?(Tuple.to_list(ip), &(is_integer(&1) and &1 in 0..max))\n  end\n\n  defp valid_ip?(_), do: false\n  defp wildcard?(ip), do: Enum.all?(Tuple.to_list(ip), &(&1 == 0))\n\n  defp limit_check(input, limits) do\n    with :ok <- known(Map.get(input, :limits, %{}), Map.keys(@limits)),\n         true <-\n           Enum.all?(limits, fn {_, n} -> is_integer(n) and n > 0 end) ||\n             {:error, :invalid_limits},\n         true <-\n           (limits.max_packet <= 65_507 and limits.max_memberships <= 64) ||\n             {:error, :invalid_limits} do\n      :ok\n    end\n  end\n\n  defp transport(%{transport: :quic}), do: {:error, {:unsupported_capability, :quic}}\n\n  defp transport(%{transport: :tls, tls: %{provider: provider}}) when provider != :otp,\n    do: {:error, {:unsupported_capability, provider}}\n\n  defp transport(%{transport: :tls} = spec) do\n    with :ok <- known(spec.tls, [:provider, :certfile, :keyfile, :alpn, :versions]),\n         true <-\n           (is_binary(spec.tls[:certfile]) and is_binary(spec.tls[:keyfile])) ||\n             {:error, :missing_credentials},\n         true <- valid_alpn?(Map.get(spec.tls, :alpn, [])) || {:error, :invalid_alpn},\n         true <-\n           Map.get(spec.tls, :versions, [:\"tlsv1.3\"]) in [\n             [:\"tlsv1.3\"],\n             [:\"tlsv1.2\"],\n             [:\"tlsv1.3\", :\"tlsv1.2\"]\n           ] || {:error, :invalid_tls_versions},\n         :ok <- empty(spec.udp),\n         :ok <- unicast(spec.mode) do\n      :ok\n    end\n  end\n\n  defp transport(%{transport: :tcp} = spec) do\n    with :ok <- empty(spec.tls), :ok <- empty(spec.udp), do: unicast(spec.mode)\n  end\n\n  defp transport(%{transport: :udp, mode: :broadcast, ip: ip}) when tuple_size(ip) == 8,\n    do: {:error, {:unsupported_capability, :ipv6_broadcast}}\n\n  defp transport(%{transport: :udp} = spec) do\n    with :ok <- empty(spec.tls),\n         true <- spec.mode in [:unicast, :broadcast, :multicast] || {:error, :invalid_udp_mode},\n         :ok <-\n           known(spec.udp, [\n             :memberships,\n             :multicast_if,\n             :multicast_ttl,\n             :multicast_loop,\n             :strict_group_filter,\n             :inet_backend\n           ]),\n         :ok <- udp_options(spec) do\n      :ok\n    end\n  end\n\n  defp transport(_), do: {:error, :invalid_transport}\n\n  defp udp_options(spec) do\n    memberships = Map.get(spec.udp, :memberships, [])\n\n    cond do\n      Map.get(spec.udp, :inet_backend, :inet) not in [:inet, :socket] ->\n        {:error, :invalid_backend}\n\n      not is_list(memberships) ->\n        {:error, :invalid_memberships}\n\n      length(memberships) > spec.limits.max_memberships ->\n        {:error, :membership_limit}\n\n      spec.mode != :multicast and map_size(Map.delete(spec.udp, :inet_backend)) != 0 ->\n        {:error, :multicast_options_require_multicast}\n\n      not Enum.all?(memberships, &valid_membership?(&1, spec.ip)) ->\n        {:error, :invalid_membership}\n\n      not is_boolean(Map.get(spec.udp, :multicast_loop, true)) ->\n        {:error, :invalid_loopback}\n\n      not is_boolean(Map.get(spec.udp, :strict_group_filter, false)) ->\n        {:error, :invalid_filter}\n\n      not (is_integer(Map.get(spec.udp, :multicast_ttl, 1)) and\n               Map.get(spec.udp, :multicast_ttl, 1) in 0..255) ->\n        {:error, :invalid_ttl}\n\n      tuple_size(spec.ip) == 8 and spec.mode == :multicast and :os.type() != {:unix, :linux} ->\n        {:error, {:unsupported_capability, :ipv6_multicast}}\n\n      true ->\n        :ok\n    end\n  end\n\n  def valid_membership?({group, interface}, ip) do\n    valid_ip?(group) and tuple_size(group) == tuple_size(ip) and\n      Abyss.Transport.UDP.Multicast.multicast_address?(group) and\n      if(tuple_size(ip) == 8,\n        do:\n          (is_integer(interface) and interface > 0) or\n            (is_binary(interface) and byte_size(interface) > 0),\n        else:\n          interface == :any or (is_binary(interface) and byte_size(interface) > 0) or\n            (valid_ip?(interface) and tuple_size(interface) == 4)\n      )\n  end\n\n  def valid_membership?(_, _), do: false\n\n  defp handler(%{transport: type, handler: module}) when is_atom(module) do\n    callback = if type == :udp, do: {:handle_datagram, 2}, else: {:handle_data, 2}\n\n    if Code.ensure_loaded?(module) and\n         function_exported?(module, elem(callback, 0), elem(callback, 1)) and\n         (type == :udp or function_exported?(module, :init, 2)),\n       do: :ok,\n       else: {:error, :invalid_handler}\n  end\n\n  defp handler(_), do: {:error, :invalid_handler}\n\n  defp requested(spec) do\n    supported =\n      [spec.transport, :pause, :drain] ++ if(spec.transport == :udp, do: [spec.mode], else: [])\n\n    if is_list(spec.capabilities) do\n      case spec.capabilities -- supported do\n        [] -> :ok\n        [cap | _] -> {:error, {:unsupported_capability, cap}}\n      end\n    else\n      {:error, :invalid_capabilities}\n    end\n  end\n\n  defp valid_alpn?(list) when is_list(list),\n    do: Enum.all?(list, &(is_binary(&1) and byte_size(&1) in 1..255))\n\n  defp valid_alpn?(_), do: false\n  defp empty(map) when map == %{}, do: :ok\n  defp empty(_), do: {:error, :inapplicable_options}\n  defp unicast(:unicast), do: :ok\n  defp unicast(_), do: {:error, :inapplicable_mode}\nend\n",
  "apps/gaoxy/lib/gaoxy/admission.ex": "defmodule Gaoxy.Admission do\n  @moduledoc false\n  use GenServer\n  alias Gaoxy.Telemetry\n\n  def start_link({limits, scope}), do: GenServer.start_link(__MODULE__, {limits, scope})\n  def acquire(gate, bytes), do: GenServer.call(gate, {:acquire, bytes})\n  def begin(gate, lease, bytes), do: GenServer.call(gate, {:begin, lease, bytes})\n  def retain(gate, lease, bytes), do: GenServer.call(gate, {:retain, lease, bytes})\n  def update(gate, lease, bytes), do: GenServer.call(gate, {:update, lease, bytes})\n  def mode(gate, mode), do: GenServer.call(gate, {:mode, mode})\n  def status(gate), do: GenServer.call(gate, :status)\n\n  @impl true\n  def init({limits, scope}),\n    do:\n      {:ok,\n       %{\n         limits: limits,\n         scope: scope,\n         mode: :ready,\n         leases: %{},\n         bytes: 0,\n         high_water: 0,\n         rejected: 0\n       }}\n\n  @impl true\n  def handle_call({:acquire, bytes}, {pid, _}, state) do\n    cond do\n      state.mode != :ready ->\n        reject(state, state.mode)\n\n      map_size(state.leases) >= state.limits.max_active ->\n        reject(state, :active_limit)\n\n      not is_integer(bytes) or bytes < 0 or state.bytes + bytes > state.limits.max_bytes ->\n        reject(state, :byte_limit)\n\n      true ->\n        ref = make_ref()\n        monitor = Process.monitor(pid)\n        lease = %{pid: pid, monitor: monitor, bytes: bytes, token: nil, timer: nil}\n        state = %{state | leases: Map.put(state.leases, ref, lease), bytes: state.bytes + bytes}\n        {:reply, {:ok, ref}, sample(state)}\n    end\n  end\n\n  def handle_call({action, ref, bytes}, {pid, _}, state)\n      when action in [:begin, :retain, :update] do\n    case state.leases[ref] do\n      %{pid: ^pid} = lease ->\n        new_bytes = state.bytes - lease.bytes + bytes\n\n        if is_integer(bytes) and bytes >= 0 and new_bytes <= state.limits.max_bytes do\n          lease =\n            case action do\n              :begin ->\n                cancel(lease)\n                token = make_ref()\n\n                timer =\n                  Process.send_after(\n                    self(),\n                    {:expired, ref, token},\n                    state.limits.callback_timeout\n                  )\n\n                %{lease | timer: timer, token: token, bytes: bytes}\n\n              :retain ->\n                cancel(lease)\n                %{lease | timer: nil, token: nil, bytes: bytes}\n\n              :update ->\n                %{lease | bytes: bytes}\n            end\n\n          {:reply, :ok,\n           sample(%{state | bytes: new_bytes, leases: Map.put(state.leases, ref, lease)})}\n        else\n          reject(state, :byte_limit)\n        end\n\n      _ ->\n        {:reply, {:error, :stale_generation}, state}\n    end\n  end\n\n  def handle_call({:mode, mode}, _from, state), do: {:reply, :ok, %{state | mode: mode}}\n\n  def handle_call(:status, _from, state) do\n    {:reply,\n     %{\n       active: map_size(state.leases),\n       retained_bytes: state.bytes,\n       retained_high_water: state.high_water,\n       rejected: state.rejected,\n       queued_items: 0,\n       queued_bytes: 0\n     }, state}\n  end\n\n  @impl true\n  def handle_info({:expired, ref, token}, state) do\n    case state.leases[ref] do\n      %{token: ^token, pid: pid} ->\n        Telemetry.emit(:timeout, %{count: 1}, state.scope, %{reason: :callback_or_send_timeout})\n        Process.exit(pid, :kill)\n\n      _ ->\n        :ok\n    end\n\n    {:noreply, state}\n  end\n\n  def handle_info({:DOWN, monitor, :process, _pid, _reason}, state) do\n    case Enum.find(state.leases, fn {_, lease} -> lease.monitor == monitor end) do\n      {ref, lease} ->\n        cancel(lease)\n\n        {:noreply,\n         sample(%{\n           state\n           | leases: Map.delete(state.leases, ref),\n             bytes: state.bytes - lease.bytes\n         })}\n\n      nil ->\n        {:noreply, state}\n    end\n  end\n\n  def handle_info(_, state), do: {:noreply, state}\n  @impl true\n  def terminate(_, state),\n    do: Enum.each(state.leases, fn {_, lease} -> Process.exit(lease.pid, :kill) end)\n\n  defp cancel(%{timer: nil}), do: :ok\n  defp cancel(%{timer: timer}), do: Process.cancel_timer(timer)\n\n  defp reject(state, reason) do\n    Telemetry.emit(:admission_rejected, %{count: 1}, state.scope, %{reason: reason})\n    {:reply, {:error, reason}, %{state | rejected: state.rejected + 1}}\n  end\n\n  defp sample(state) do\n    Telemetry.emit(\n      :work,\n      %{active: map_size(state.leases), retained_bytes: state.bytes},\n      state.scope\n    )\n\n    %{state | high_water: max(state.high_water, state.bytes)}\n  end\nend\n",
  "apps/gaoxy/lib/gaoxy/stream_bridge.ex": "defmodule Gaoxy.StreamBridge do\n  @moduledoc false\n  use ThousandIsland.Handler\n  alias Gaoxy.Admission\n\n  @impl true\n  def handle_connection(socket, %{spec: spec, gate: gate} = state) do\n    with {:ok, lease} <- Admission.acquire(gate, 0),\n         :ok <- Admission.begin(gate, lease, 0),\n         {:ok, local} <- ThousandIsland.Socket.sockname(socket),\n         {:ok, peer} <- ThousandIsland.Socket.peername(socket),\n         {:ok, app} <-\n           spec.handler.init(\n             %{\n               local: local,\n               peer: peer,\n               transport: spec.transport,\n               alpn: ThousandIsland.Socket.negotiated_protocol(socket)\n             },\n             spec.handler_options\n           ),\n         :ok <- retain(gate, lease, app, spec) do\n      {:continue, Map.merge(state, %{lease: lease, app: app})}\n    else\n      {:error, reason} -> {:error, reason, state}\n    end\n  end\n\n  @impl true\n  def handle_data(bytes, socket, %{spec: spec, gate: gate, lease: lease, app: app} = state) do\n    with :ok <- Admission.begin(gate, lease, byte_size(bytes) + :erlang.external_size(app)) do\n      # Delivery boundaries are arbitrary; split a large OS delivery without dropping stream bytes.\n      chunks(bytes, socket, state, spec.limits.max_packet)\n    else\n      {:error, reason} -> {:error, reason, state}\n    end\n  end\n\n  defp chunks(<<>>, _socket, state, _limit) do\n    case retain(state.gate, state.lease, state.app, state.spec) do\n      :ok -> {:continue, state}\n      {:error, reason} -> {:error, reason, state}\n    end\n  end\n\n  defp chunks(bytes, socket, state, limit) do\n    size = min(byte_size(bytes), limit)\n    <<chunk::binary-size(^size), rest::binary>> = bytes\n\n    case state.spec.handler.handle_data(chunk, state.app) do\n      {:continue, app} ->\n        next(rest, socket, %{state | app: app}, limit)\n\n      {:send, output, app} ->\n        new_state = %{state | app: app}\n\n        with :ok <- state_bound(app, state.spec),\n             :ok <- output_bound(output, state.spec),\n             :ok <-\n               Admission.update(\n                 state.gate,\n                 state.lease,\n                 byte_size(bytes) + :erlang.external_size(app) + IO.iodata_length(output)\n               ),\n             :ok <- ThousandIsland.Socket.send(socket, output) do\n          Gaoxy.Telemetry.emit(:send, %{bytes: IO.iodata_length(output)}, state.scope, %{\n            outcome: :local_completed\n          })\n\n          next(rest, socket, new_state, limit)\n        else\n          {:error, reason} -> {:error, reason, new_state}\n        end\n\n      {:close, app} ->\n        {:close, %{state | app: app}}\n\n      {:error, reason, app} ->\n        {:error, reason, %{state | app: app}}\n    end\n  end\n\n  defp next(rest, socket, state, limit) do\n    with :ok <- state_bound(state.app, state.spec),\n         :ok <-\n           Admission.update(\n             state.gate,\n             state.lease,\n             byte_size(rest) + :erlang.external_size(state.app)\n           ) do\n      chunks(rest, socket, state, limit)\n    else\n      {:error, reason} -> {:error, reason, state}\n    end\n  end\n\n  defp retain(gate, lease, app, spec) do\n    with :ok <- state_bound(app, spec),\n         do: Admission.retain(gate, lease, :erlang.external_size(app))\n  end\n\n  defp state_bound(app, spec) do\n    if :erlang.external_size(app) <= spec.limits.max_state, do: :ok, else: {:error, :state_limit}\n  end\n\n  defp output_bound(output, spec) do\n    if IO.iodata_length(output) <= spec.limits.max_output, do: :ok, else: {:error, :output_limit}\n  end\n\n  @impl true\n  def handle_close(_socket, state), do: terminate_app(:closed, state)\n  @impl true\n  def handle_error(reason, _socket, state), do: terminate_app(reason, state)\n  @impl true\n  def handle_shutdown(_socket, state), do: terminate_app(:shutdown, state)\n  @impl true\n  def handle_timeout(_socket, state), do: terminate_app(:idle_timeout, state)\n\n  defp terminate_app(reason, %{spec: spec, app: app, gate: gate, lease: lease}) do\n    if function_exported?(spec.handler, :terminate, 2) do\n      :ok = Admission.begin(gate, lease, :erlang.external_size(app))\n      spec.handler.terminate(reason, app)\n    end\n  end\n\n  defp terminate_app(_, _), do: :ok\nend\n",
  "apps/gaoxy/lib/gaoxy/datagram_bridge.ex": "defmodule Gaoxy.DatagramBridge do\n  @moduledoc false\n  use Abyss.Handler\n  alias Gaoxy.Admission\n\n  @impl true\n  def handle_data({peer, port, bytes}, state) do\n    %{spec: spec, gate: gate, scope: scope} = state.server_config.handler_options\n\n    with {:ok, lease} <- Admission.acquire(gate, byte_size(bytes)),\n         :ok <- Admission.begin(gate, lease, byte_size(bytes)) do\n      metadata = state.connection_span.start_metadata\n\n      packet = %{\n        data: bytes,\n        peer: {peer, port},\n        local: metadata[:local_info],\n        destination: :unknown,\n        interface: :unknown,\n        ancillary: Map.get(metadata, :ancillary, [])\n      }\n\n      case spec.handler.handle_datagram(packet, spec.handler_options) do\n        :ok ->\n          :ok\n\n        {:error, reason} ->\n          Gaoxy.Telemetry.emit(:handler_error, %{count: 1}, scope, %{reason: reason})\n\n        {:reply, output} ->\n          size = IO.iodata_length(output)\n\n          if size <= min(spec.limits.max_output, 65_507) do\n            with :ok <- Admission.update(gate, lease, byte_size(bytes) + size) do\n              result = state.server_config.transport_module.send(state.socket, peer, port, output)\n              Gaoxy.Telemetry.emit(:send, %{bytes: size}, scope, %{outcome: result})\n            end\n          else\n            Gaoxy.Telemetry.emit(:admission_rejected, %{count: 1}, scope, %{reason: :output_limit})\n          end\n      end\n    end\n\n    {:close, state}\n  end\nend\n",
  "apps/gaoxy/lib/gaoxy/application.ex": "defmodule Gaoxy.Application do\n  @moduledoc false\n  use Application\n  @impl true\n  def start(_, _),\n    do:\n      Supervisor.start_link([{Registry, keys: :unique, name: Gaoxy.Registry}],\n        strategy: :one_for_one\n      )\nend\n",
  "apps/gaoxy/lib/gaoxy/datagram_handler.ex": "defmodule Gaoxy.DatagramHandler do\n  @moduledoc \"One isolated invocation per admitted packet, including empty packets. No shared socket is exposed.\"\n  @callback handle_datagram(map(), term()) :: :ok | {:reply, iodata()} | {:error, term()}\nend\n",
  "apps/gaoxy/lib/gaoxy/stream_handler.ex": "defmodule Gaoxy.StreamHandler do\n  @moduledoc \"Callbacks execute in an isolated connection owner. Input is an ordered byte stream, not messages.\"\n  @callback init(map(), term()) :: {:ok, term()} | {:error, term()}\n  @callback handle_data(binary(), term()) ::\n              {:continue, term()}\n              | {:send, iodata(), term()}\n              | {:close, term()}\n              | {:error, term(), term()}\n  @callback terminate(term(), term()) :: term()\n  @optional_callbacks terminate: 2\nend\n",
  "apps/gaoxy/test/runtime_test.exs": "defmodule Gaoxy.RuntimeTest do\n  use ExUnit.Case, async: true\n\n  defmodule Lines do\n    @behaviour Gaoxy.StreamHandler\n    def init(_, options), do: {:ok, {\"\", options}}\n\n    def handle_data(bytes, {pending, options}) do\n      case String.split(pending <> bytes, \"\\n\", parts: 2) do\n        [rest] -> {:continue, {rest, options}}\n        [line, rest] -> {:send, line <> \"\\n\", {rest, options}}\n      end\n    end\n  end\n\n  defmodule UDP do\n    @behaviour Gaoxy.DatagramHandler\n    def handle_datagram(packet, owner) do\n      if is_pid(owner), do: send(owner, {:packet, self(), packet})\n\n      case packet.data do\n        \"crash\" ->\n          raise \"fixture crash\"\n\n        \"wait\" ->\n          receive do\n            :release -> {:reply, \"done\"}\n          end\n\n        bytes ->\n          {:reply, bytes}\n      end\n    end\n  end\n\n  def spec(type, id \\\\ \"echo\", options \\\\ %{}),\n    do:\n      Map.merge(\n        %{id: id, transport: type, handler: if(type == :udp, do: UDP, else: Lines)},\n        options\n      )\n\n  def instance(services) do\n    pid = start_supervised!({Gaoxy, services: services})\n    on_exit(fn -> if Process.alive?(pid), do: Gaoxy.stop(pid, 0) end)\n    pid\n  end\n\n  def endpoint(pid, id \\\\ \"echo\") do\n    %{local: local} = Gaoxy.info(pid, id)\n\n    case local do\n      {:ok, address} -> address\n      address -> address\n    end\n  end\n\n  def eventually(fun, deadline \\\\ nil) do\n    deadline = deadline || System.monotonic_time(:millisecond) + 2_000\n\n    case fun.() do\n      false ->\n        assert System.monotonic_time(:millisecond) < deadline, \"readiness condition timed out\"\n\n        receive do\n        after\n          5 -> eventually(fun, deadline)\n        end\n\n      result ->\n        result\n    end\n  end\n\n  @tag :loopback\n  test \"two instances reuse service identities and reconstruct fragmented streams independently\" do\n    a = instance([spec(:tcp)])\n    b = instance([spec(:tcp)])\n    {ip, port} = endpoint(a)\n    {_, other_port} = endpoint(b)\n    assert port > 0 and other_port > 0 and port != other_port\n    {:ok, client} = :gen_tcp.connect(ip, port, [:binary, active: false], 1_000)\n    :ok = :gen_tcp.send(client, \"frag\")\n    :ok = :gen_tcp.send(client, \"mented\\n\")\n    assert {:ok, \"fragmented\\n\"} = :gen_tcp.recv(client, 0, 1_000)\n    :gen_tcp.close(client)\n    assert :ok = Gaoxy.remove(a, \"echo\", 1_000)\n    assert [] = Gaoxy.services(a)\n    assert [\"echo\"] = Gaoxy.services(b)\n    assert {:error, :not_running} = Gaoxy.info(a, \"echo\")\n  end\n\n  @tag :loopback\n  test \"binding failure rolls back an already opened sibling socket\" do\n    {:ok, occupied} = :gen_tcp.listen(0, ip: {127, 0, 0, 1}, active: false)\n    {:ok, {_, port}} = :inet.sockname(occupied)\n    {:ok, probe} = :gen_tcp.listen(0, ip: {127, 0, 0, 1}, active: false)\n    {:ok, {_, free}} = :inet.sockname(probe)\n    :gen_tcp.close(probe)\n\n    assert {:error, _} =\n             Gaoxy.start_link(\n               services: [\n                 spec(:tcp, \"first\", %{port: free}),\n                 spec(:tcp, \"occupied\", %{port: port})\n               ]\n             )\n\n    eventually(fn ->\n      case :gen_tcp.listen(free, ip: {127, 0, 0, 1}, active: false) do\n        {:ok, socket} ->\n          :gen_tcp.close(socket)\n          true\n\n        _ ->\n          false\n      end\n    end)\n\n    :gen_tcp.close(occupied)\n  end\n\n  @tag :loopback\n  test \"UDP preserves empty packets and oversize rejection; crashes do not close the socket\" do\n    pid = instance([spec(:udp, \"echo\", %{handler_options: self(), limits: %{max_packet: 8}})])\n    {ip, port} = endpoint(pid)\n    {:ok, client} = :gen_udp.open(0, [:binary, active: false])\n\n    for bytes <- [\"\", \"hello\"] do\n      :ok = :gen_udp.send(client, ip, port, bytes)\n      assert {:ok, {^ip, ^port, ^bytes}} = :gen_udp.recv(client, 0, 1_000)\n      assert_receive {:packet, _, %{data: ^bytes, destination: :unknown, interface: :unknown}}\n    end\n\n    :ok = :gen_udp.send(client, ip, port, \"oversized\")\n    eventually(fn -> Gaoxy.status(pid, \"echo\").backend.dropped > 0 end)\n    :ok = :gen_udp.send(client, ip, port, \"crash\")\n    assert_receive {:packet, _, %{data: \"crash\"}}\n    :ok = :gen_udp.send(client, ip, port, \"alive\")\n    assert {:ok, {^ip, ^port, \"alive\"}} = :gen_udp.recv(client, 0, 1_000)\n    :gen_udp.close(client)\n  end\n\n  @tag :loopback\n  test \"paused UDP retains its endpoint and admitted work can reply during drain\" do\n    pid = instance([spec(:udp, \"echo\", %{handler_options: self()})])\n    {ip, port} = endpoint(pid)\n    {:ok, client} = :gen_udp.open(0, [:binary, active: false])\n    :ok = :gen_udp.send(client, ip, port, \"wait\")\n    assert_receive {:packet, worker, %{data: \"wait\"}}\n    assert :ok = Gaoxy.pause(pid, \"echo\")\n    assert {^ip, ^port} = endpoint(pid)\n    assert :ok = Gaoxy.resume(pid, \"echo\")\n    owner = self()\n    remover = spawn(fn -> send(owner, {:removed, Gaoxy.remove(pid, \"echo\", 1_000)}) end)\n    assert is_pid(remover)\n    eventually(fn -> Gaoxy.status(pid, \"echo\").state == :draining end)\n    send(worker, :release)\n    assert {:ok, {^ip, ^port, \"done\"}} = :gen_udp.recv(client, 0, 1_000)\n    assert_receive {:removed, :ok}, 1_500\n    assert {:error, :not_running} = Gaoxy.info(pid, \"echo\")\n    :gen_udp.close(client)\n  end\n\n  @tag :loopback\n  test \"deadline forces cleanup and intentionally removed child remains stopped\" do\n    pid = instance([spec(:udp, \"echo\", %{handler_options: self()})])\n    {ip, port} = endpoint(pid)\n    {:ok, client} = :gen_udp.open(0, [:binary, active: false])\n    :ok = :gen_udp.send(client, ip, port, \"wait\")\n    assert_receive {:packet, worker, _}\n    monitor = Process.monitor(worker)\n    assert :ok = Gaoxy.remove(pid, \"echo\", 10)\n    assert_receive {:DOWN, ^monitor, :process, ^worker, _}, 1_000\n    assert [] = Gaoxy.services(pid)\n    assert {:error, :not_running} = Gaoxy.handle(pid, \"echo\")\n    :gen_udp.close(client)\n  end\n\n  @tag :loopback\n  test \"sustained UDP overload stays bounded and callback watchdog recovers capacity\" do\n    pid =\n      instance([\n        spec(:udp, \"echo\", %{\n          handler_options: self(),\n          limits: %{max_active: 2, max_packet: 1024, max_bytes: 4096, callback_timeout: 500}\n        }),\n        spec(:udp, \"other\")\n      ])\n\n    {ip, port} = endpoint(pid)\n    {:ok, client} = :gen_udp.open(0, [:binary, active: false])\n    :ok = :gen_udp.send(client, ip, port, \"wait\")\n    assert_receive {:packet, first, _}\n    :ok = :gen_udp.send(client, ip, port, \"wait\")\n    assert_receive {:packet, second, _}\n    for _ <- 1..1_000, do: :gen_udp.send(client, ip, port, \"wait\")\n    eventually(fn -> Gaoxy.status(pid, \"echo\").backend.dropped > 0 end)\n\n    assert %{\n             active: active,\n             retained_bytes: retained,\n             queued_items: 0,\n             backend: %{active_high_water: high, starting: starting}\n           } = Gaoxy.status(pid, \"echo\")\n\n    assert active <= 2 and high <= 2 and starting <= 1 and retained <= 4096\n    {_, other} = endpoint(pid, \"other\")\n    :ok = :gen_udp.send(client, ip, other, \"isolated\")\n    assert {:ok, {^ip, ^other, \"isolated\"}} = :gen_udp.recv(client, 0, 1_000)\n    eventually(fn -> not Process.alive?(first) and not Process.alive?(second) end)\n    :gen_udp.close(client)\n  end\n\n  @tag :loopback\n  test \"TCP pause unbinds while admitted connections continue; resume reports its actual port\" do\n    pid = instance([spec(:tcp)])\n    {ip, port} = endpoint(pid)\n    {:ok, client} = :gen_tcp.connect(ip, port, [:binary, active: false])\n    eventually(fn -> Gaoxy.status(pid, \"echo\").active == 1 end)\n    assert :ok = Gaoxy.pause(pid, \"echo\")\n    assert {:error, _} = :gen_tcp.connect(ip, port, [:binary, active: false], 500)\n    :ok = :gen_tcp.send(client, \"admitted\\n\")\n    assert {:ok, \"admitted\\n\"} = :gen_tcp.recv(client, 0, 1_000)\n    assert :ok = Gaoxy.resume(pid, \"echo\")\n    {^ip, new_port} = endpoint(pid)\n    assert new_port > 0\n    :gen_tcp.close(client)\n  end\nend\n",
  "apps/gaoxy/test/tls_test.exs": "defmodule Gaoxy.TLSTest do\n  use ExUnit.Case, async: true\n\n  defmodule Echo do\n    @behaviour Gaoxy.StreamHandler\n    def init(_, _), do: {:ok, nil}\n    def handle_data(bytes, state), do: {:send, bytes, state}\n  end\n\n  @tag :loopback\n  @tag :tmp_dir\n  test \"independent OpenSSL peer validates TLS and rejects invalid trust\", %{tmp_dir: dir} do\n    root = Path.expand(\"../../..\", __DIR__)\n    assert {_, 0} = System.cmd(\"bash\", [Path.join(root, \"scripts/generate-fixtures.sh\"), dir])\n\n    pid =\n      start_supervised!(\n        {Gaoxy,\n         services: [\n           %{\n             id: \"tls\",\n             transport: :tls,\n             handler: Echo,\n             tls: %{\n               provider: :otp,\n               certfile: Path.join(dir, \"cert.pem\"),\n               keyfile: Path.join(dir, \"key.pem\"),\n               alpn: [\"gaoxy-echo-v1\"]\n             }\n           }\n         ]}\n      )\n\n    assert %{local: {:ok, {_, port}}} = Gaoxy.info(pid, \"tls\")\n\n    assert {output, 0} =\n             System.cmd(\n               \"python3\",\n               [\n                 Path.join(root, \"integration/tls_peer.py\"),\n                 Integer.to_string(port),\n                 Path.join(dir, \"ca.pem\")\n               ],\n               stderr_to_stdout: true\n             )\n\n    assert output =~ \"PASS TLS exchange\"\n    assert :ok = Gaoxy.stop(pid, 1_000)\n  end\nend\n",
  "apps/gaoxy/test/test_helper.exs": "ExUnit.start()\n",
  "apps/gaoxy/test/config_test.exs": "defmodule Gaoxy.ConfigTest do\n  use ExUnit.Case, async: true\n\n  defmodule Stream do\n    def init(_, _), do: {:ok, \"\"}\n    def handle_data(data, state), do: {:send, data, state}\n  end\n\n  def service(extra \\\\ %{}), do: Map.merge(%{id: \"echo\", transport: :tcp, handler: Stream}, extra)\n\n  test \"pure validation returns a finite immutable plan\" do\n    assert {:ok, %{services: [%{id: \"echo\", port: 0, limits: %{max_active: 64}}]}} =\n             Gaoxy.Config.validate(services: [service()])\n  end\n\n  test \"unknown options, duplicate identities and conflicting socket ownership fail\" do\n    assert {:error, {:unknown_options, [:typo]}} = Gaoxy.Config.validate(typo: true)\n\n    assert {:error, {:duplicate_service, \"echo\"}} =\n             Gaoxy.Config.validate(services: [service(), service()])\n\n    assert {:error, {:binding_conflict, \"other\", \"echo\"}} =\n             Gaoxy.Config.validate(\n               services: [service(%{port: 4000}), service(%{id: \"other\", port: 4000})]\n             )\n\n    assert {:error, _} =\n             Gaoxy.Config.validate(services: [service(%{limits: %{max_active: :infinity}})])\n  end\n\n  test \"explicit unsupported providers and capabilities never fall back\" do\n    assert {:error, {:unsupported_capability, :ex_ssl}} =\n             Gaoxy.Config.validate(\n               services: [service(%{transport: :tls, tls: %{provider: :ex_ssl}})]\n             )\n\n    assert {:error, {:unsupported_capability, :quic}} =\n             Gaoxy.Config.validate(services: [service(%{transport: :quic})])\n\n    assert {:error, {:unsupported_capability, :http3}} =\n             Gaoxy.Config.validate(services: [service(%{capabilities: [:http3]})])\n  end\n\n  test \"IPv6 broadcast and scope-free IPv6 multicast are rejected\" do\n    assert {:error, {:unsupported_capability, :ipv6_broadcast}} =\n             Gaoxy.Config.validate(\n               services: [\n                 service(%{transport: :udp, mode: :broadcast, ip: {0, 0, 0, 0, 0, 0, 0, 0}})\n               ]\n             )\n\n    assert {:error, _} =\n             Gaoxy.Config.validate(\n               services: [\n                 service(%{\n                   transport: :udp,\n                   mode: :multicast,\n                   ip: {0, 0, 0, 0, 0, 0, 0, 0},\n                   udp: %{memberships: [{{0xFF02, 0, 0, 0, 0, 0, 0, 42}, :any}]}\n                 })\n               ]\n             )\n  end\nend\n"
}
