{<<"app">>,<<"http_fetch">>}.
{<<"build_tools">>,[<<"mix">>]}.
{<<"description">>,
 <<"A browser-like HTTP fetch API for Elixir using Erlang's built-in socket modules">>}.
{<<"elixir">>,<<"~> 1.18">>}.
{<<"files">>,
 [<<"CHANGELOG.md">>,
  <<"LICENSE">>,
  <<"README.md">>,
  <<"lib">>,
  <<"lib/http">>,
  <<"lib/http.ex">>,
  <<"lib/http/abort_controller.ex">>,
  <<"lib/http/config.ex">>,
  <<"lib/http/content_decoder.ex">>,
  <<"lib/http/fetch_options.ex">>,
  <<"lib/http/http1">>,
  <<"lib/http/http1/upload.ex">>,
  <<"lib/http/http2">>,
  <<"lib/http/http2/body_bridge.ex">>,
  <<"lib/http/promise.ex">>,
  <<"lib/http/request_completion.ex">>,
  <<"lib/http/request_error.ex">>,
  <<"lib/http/response.ex">>,
  <<"lib/http/socket_client.ex">>,
  <<"lib/http/status_text.ex">>,
  <<"lib/http/stream.ex">>,
  <<"lib/http/stream_writer.ex">>,
  <<"lib/http/telemetry.ex">>,
  <<"lib/http/unix_socket.ex">>,
  <<"lib/http_fetch.ex">>,
  <<"mix.exs">>]}.
{<<"licenses">>,[<<"MIT">>]}.
{<<"links">>,[{<<"GitHub">>,<<"https://github.com/gsmlg-dev/http_fetch">>}]}.
{<<"name">>,<<"http_fetch">>}.
{<<"requirements">>,
 [[{<<"app">>,<<"http_core">>},
   {<<"name">>,<<"http_core">>},
   {<<"optional">>,false},
   {<<"repository">>,<<"hexpm">>},
   {<<"requirement">>,<<"== 0.21.4">>}],
  [{<<"app">>,<<"http_runtime">>},
   {<<"name">>,<<"http_runtime">>},
   {<<"optional">>,false},
   {<<"repository">>,<<"hexpm">>},
   {<<"requirement">>,<<"== 0.21.4">>}],
  [{<<"app">>,<<"telemetry">>},
   {<<"name">>,<<"telemetry">>},
   {<<"optional">>,false},
   {<<"repository">>,<<"hexpm">>},
   {<<"requirement">>,<<"~> 1.0">>}]]}.
{<<"version">>,<<"0.21.4">>}.
