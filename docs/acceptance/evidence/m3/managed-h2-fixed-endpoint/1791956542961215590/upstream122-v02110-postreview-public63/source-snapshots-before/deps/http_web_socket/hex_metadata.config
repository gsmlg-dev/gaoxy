{<<"app">>,<<"http_web_socket">>}.
{<<"build_tools">>,[<<"mix">>]}.
{<<"description">>,<<"A browser-like WebSocket client API for Elixir">>}.
{<<"elixir">>,<<"~> 1.18">>}.
{<<"files">>,
 [<<"LICENSE">>,
  <<"lib">>,
  <<"lib/http">>,
  <<"lib/http/web_socket">>,
  <<"lib/http/web_socket.ex">>,
  <<"lib/http/web_socket/array_buffer.ex">>,
  <<"lib/http/web_socket/connection.ex">>,
  <<"lib/http/web_socket/event.ex">>,
  <<"lib/http/web_socket/frame.ex">>,
  <<"lib/http/web_socket/handshake.ex">>,
  <<"lib/http/web_socket/options.ex">>,
  <<"lib/http/web_socket/telemetry.ex">>,
  <<"lib/http_web_socket">>,
  <<"lib/http_web_socket.ex">>,
  <<"lib/http_web_socket/application.ex">>,
  <<"mix.exs">>]}.
{<<"licenses">>,[<<"MIT">>]}.
{<<"links">>,[{<<"GitHub">>,<<"https://github.com/gsmlg-dev/http_fetch">>}]}.
{<<"name">>,<<"http_web_socket">>}.
{<<"requirements">>,
 [[{<<"app">>,<<"http_core">>},
   {<<"name">>,<<"http_core">>},
   {<<"optional">>,false},
   {<<"repository">>,<<"hexpm">>},
   {<<"requirement">>,<<"== 0.21.10">>}],
  [{<<"app">>,<<"http_runtime">>},
   {<<"name">>,<<"http_runtime">>},
   {<<"optional">>,false},
   {<<"repository">>,<<"hexpm">>},
   {<<"requirement">>,<<"== 0.21.10">>}],
  [{<<"app">>,<<"telemetry">>},
   {<<"name">>,<<"telemetry">>},
   {<<"optional">>,false},
   {<<"repository">>,<<"hexpm">>},
   {<<"requirement">>,<<"~> 1.0">>}]]}.
{<<"version">>,<<"0.21.10">>}.
