{<<"app">>,<<"http_runtime">>}.
{<<"build_tools">>,[<<"mix">>]}.
{<<"description">>,<<"Shared pooled HTTP/2 runtime for HTTP stream clients">>}.
{<<"elixir">>,<<"~> 1.18">>}.
