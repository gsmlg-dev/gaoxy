  "actionable_findings": [
    {
      "id": "BRCODE1-F1",
      "priority": "P2",
      "title": "Guarantee descendant cleanup when generic collector timeout handling raises",
      "path": "docs/acceptance/evidence/m3/managed-h2-group-generation/1792155884508467786/command-collector1.py",
      "line_start": 101,
      "line_end": 111,
      "evidence": "The only wait handlers catch subprocess.TimeoutExpired. os.killpg at105/109 is unguarded and cleanup_descendants is an ordinary statement at111, outside any finally. Static AST confirms both wait try nodes have zero finalbody statements.",
      "trigger": "The command exits after process.wait raises TimeoutExpired but before os.killpg executes: killpg may raise ProcessLookupError. An exception from the final bounded wait likewise escapes. A launched browser/host/peer may already own a separate session, as the reviewed runner explicitly does.",
      "impact": "The collector exits before bounded descendant cleanup/reaping and before immutable FAIL/actual-exit/join evidence is written. Separately sessioned descendants can remain alive and lose collector custody. It cannot be treated as fail-safe ownership for the frozen collector gate. This is an orchestration defect, not a production or dependency bug.",
      "requested_change": "Protect the complete owned-process lifetime with try/finally so descendant cleanup and actual child status reconciliation always run; tolerate ProcessLookupError at signal races, preserve wait errors and forced/unfinished status in an immutable FAIL receipt, and never turn this path into PASS. The adjacent browser-command-collector1.py already demonstrates the required cleanup-finally pattern.",
      "verification_expectation": "Root should validate the corrected collector with bounded deterministic exception/race cases for ProcessLookupError during TERM/KILL and final wait failure, proving cleanup runs and failure/actual status survives. Rebind/review changed collector and candidate before consuming it. No reviewed runtime gate was executed here."
    }
  ],
