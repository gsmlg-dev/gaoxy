+  defp reload_join_peer(epoch, profile) do
+    completed = Process.get({__MODULE__, :reload_closed, epoch.peer}, [])
+    accepts = if epoch.index < 2, do: 8, else: 7
+    requests = case {profile, epoch.lane, epoch.index} do
+      {:active, :a, 2} -> 26
+      {:active, :a, _} -> 32
+      {:active, :b, 2} -> 20
+      {:active, :b, _} -> 24
+      {:idle, _, 2} -> 14
+      {:idle, _, _} -> 16
+    end
+    assert length(completed) == accepts
+    assert Enum.all?(completed, &(&1.epoch == epoch.index and &1.lane == epoch.lane and
+      &1.public_await == :ok and &1.owner_confirmed and &1.removed and &1.creator_down == :normal))
+    assert Enum.map(completed, & &1.physical["connection"]) == Enum.to_list(1..accepts)
+    peer = epoch.peer
+    assert Process.get({F, :observed_requests, peer}) == requests
+    monitor = Process.monitor(peer)
+    send(peer, {:command, %{"op" => "stop"}})
+    joined = F.event(peer, "joined")
+    assert %{"forced" => 0, "live" => 0, "failed" => false,
+      "accepts" => ^accepts, "requests" => ^requests} = joined
+    for name <- ["accept", "tls", "request"], do: F.no_event(peer, name)
+    assert_receive {:fixed_h2_peer_exit, ^peer, 0}, @timeout
+    assert_receive {:DOWN, ^monitor, :process, ^peer, :normal}, @timeout
+    assert {:ok, rebound} = :gen_tcp.listen(epoch.ready["port"],
+      [:binary, active: false, ip: epoch.address, reuseaddr: true])
+    assert :ok = :gen_tcp.close(rebound)
+    row = %{epoch: epoch.index, lane: epoch.lane, peer: reload_id(peer), address: reload_id(epoch.address),
+      port: epoch.ready["port"], resources: completed, joined: joined,
+      exit: 0, collector_down: :normal, rebound: true}
+    key = {__MODULE__, :reload_peer_joins}
+    Process.put(key, Process.get(key, []) ++ [row])
+    row
+  end
+
+  defp reload_totals(ledger, final, peers, profile) do
+    health = Enum.flat_map(ledger, & &1.health)
+    seeds = Enum.flat_map(ledger, & &1.seed)
+    held = Enum.flat_map(ledger, fn row -> if Map.get(row, :held), do: row.held.requests, else: [] end)
+    retired = Enum.flat_map(tl(ledger), & &1.retirement.transports) ++ final.transports
+    joins = Process.get({__MODULE__, :reload_peer_joins}, [])
+    groups = Enum.map(tl(ledger), & &1.retirement.group) ++ [final.group]
+    assert length(health) == 46 and length(seeds) == 46
+    assert length(held) == if(profile == :active, do: 66, else: 0)
+    assert length(retired) == 46 and length(Enum.uniq(Enum.map(retired, & &1.resource))) == 46
+    assert length(groups) == 23 and length(Enum.uniq(groups)) == 23
+    assert Enum.all?(tl(ledger), & &1.retirement.group_removed) and final.group_removed
+    assert length(joins) == 6 and length(peers) == 6
+    assert Enum.count(tl(ledger), &Map.has_key?(&1, :cas)) == 22
+    assert Enum.count(tl(ledger), &(&1.rollback != nil)) == 1
+    assert Enum.count(tl(ledger), &(&1.capacity != nil)) == 1
+    assert Enum.sum(Enum.map(joins, & &1.joined["accepts"])) == 46
+    requests = length(health) + length(seeds) + length(held)
+    assert requests == if(profile == :active, do: 158, else: 92)
+    assert Enum.sum(Enum.map(joins, & &1.joined["requests"])) == requests
+    assert Enum.all?(health, &(&1.public_await == :ok and &1.probe_down == :normal))
+    assert Enum.all?(seeds ++ held, &(&1.original_complete == :ok and &1.session_down == :normal))
+    %{generations: length(groups), distinct_transports: length(retired), initial_publication: 1,
+      replacement_cas: 22, heads: length(health), seed_gets: length(seeds), active_gets: length(held),
+      gets: length(seeds) + length(held), requests: requests, retirement_receipts: length(retired),
+      physical_closes: length(retired), group_removals: length(groups), peer_joins: length(joins),
+      accepts: Enum.sum(Enum.map(joins, & &1.joined["accepts"]))}
+  end
+
+  defp reload_inventory_fields do
+    %{plateau: [:transport, :transport_bytes, :transport_pin_batches, :transport_snapshots,
+        :group, :store, :source_classes, :ordered_pair_class, :service, :gate],
+      identities: [:sut, :generation, :group, :transports, :creators, :creator_monitors,
+        :group_baseline, :transport_baseline, :group_member_configs, :transport_controls,
+        :request_source_batches, :request_children, :tokens, :sessions, :completions,
+        :native_workers, :native_actors, :retirement_receipts, :retirement_helpers,
+        :peer_epochs, :peer_connections, :peer_streams],
+      absolute_times: [:transport_preparation_deadline, :group_pin_deadline,
+        :checked, :due, :scheduling_lag, :request_deadline, :hold_started,
+        :entered_monotonic_ms, :embedding_creation_interval_monotonic_ms],
+      cumulative: [:service_retained_high_water, :service_rejected, :gate_retained_high_water,
+        :gate_rejected, :owner_effects, :group_probe_cursor, :observed_peer_requests],
+      original_full_serialized_byte_fields_retained: [:transport_payload, :transport_pin_record,
+        :transport_token_payload, :group_installed_config_reserve, :group_full_current_record,
+        :group_member_config, :group_full_member, :group_control_record, :group_probe_reservation,
+        :source, :prepared_policy, :manifest, :trust, :ordered_sources, :router,
+        :baseline_list, :baseline_record, :service_cleanup, :gate_lease, :gate_cleanup]}
+  end
+
+  defp reload_inventory(f, current, gate) do
+    g = :sys.get_state(f.groups)
+    t = :sys.get_state(f.owner)
+    actual_gate = :sys.get_state(gate)
+    service = Gaoxy.status(f.instance, :http)
+    group = g.groups[group_key(current.group)]
+    public = UpstreamGroups.status(current.group)
+    store = :sys.get_state(f.store)
+    effects = collect_effects(Process.get({__MODULE__, :effects}, []))
+    Process.put({__MODULE__, :effects}, effects)
+    %{sut: reload_id(reload_identity(f)), generation: reload_id(current.generation),
+      group: reload_id(current.group), transports: Enum.map(current.transports, &reload_id/1),
+      creators: Enum.map(current.creators, fn {pid, monitor} -> %{pid: reload_id(pid), monitor: reload_id(monitor)} end),
+      baseline: Enum.map(store.baseline, &reload_id/1),
+      group_member_configs: Enum.map(group.members, &reload_id(&1.config)),
+      group_members_absolute_times: Enum.zip_with(group.members, public.members, fn original, status ->
+        %{id: original.id, checked: original.checked, due: original.due, scheduling_lag: status.scheduling_lag}
+      end),
+      transport_controls: Enum.map(current.transports, fn transport ->
+        entry = t.records[transport.resource]
+        %{resource: reload_id(transport.resource), custodian: reload_id(entry.custodian),
+          custodian_monitor: reload_id(entry.custodian_monitor), capability: reload_id(entry.capability),
+          preparer: reload_id(entry.preparer), preparer_monitor: reload_id(entry.preparer_monitor),
+          preparation_deadline: entry.deadline, payload_control_slots: reload_id(entry.payload.control_slots)}
+      end),
+      group_pin_deadlines: Enum.map(g.pins, fn {ref, p} -> %{ref: reload_id(ref), deadline: p.deadline,
+        monitor: reload_id(p.monitor), timer: reload_id(p.timer), operation: reload_id(p.operation)} end),
+      cumulative: %{service_retained_high_water: service.retained_high_water, service_rejected: service.rejected,
+        gate_retained_high_water: actual_gate.high_water, gate_rejected: actual_gate.rejected,
+        owner_effects: length(effects), group_probe_cursor: g.probe_cursor}}
+  end
+
+  defp reload_health_receipts(current) do
+    Enum.with_index(current.health, fn health, index ->
+      probe = Enum.find(current.reload_probes, &(&1.index == index))
+      %{member: index, resource: reload_id(Enum.at(current.transports, index).resource),
+        generation: reload_id(current.generation), peer: reload_id(health.peer),
+        request: health.request, completion: reload_opaque_id(:request_completion, health.completion),
+        probe: reload_id(probe.pid), probe_monitor: reload_id(probe.monitor), probe_ref: reload_id(probe.ref),
+        probe_bytes: probe.bytes, public_await: :ok, probe_down: :normal}
+    end)
+  end
+
+  defp reload_request_receipt(current, call) do
+    %{epoch: call.epoch.index, lane: call.epoch.lane, member: call.member,
+      peer: reload_id(call.peer), generation: reload_id(current.generation),
+      group: reload_id(current.group), selected: reload_id(call.bound.selected),
+      request: call.request, source_batches: %{group: reload_id(call.captured.gpin), transports: reload_id(call.captured.tpin)},
+      source_inputs: %{holder: reload_id(call.captured.native), acquirer: reload_id(call.source_acquirer),
+        deadline: call.captured.exchange.deadline},
+      child: reload_id(call.bound.child), child_source_ref: reload_id(call.captured.tpin.ref),
+      group_token: reload_id(call.bound.group_token), transport_token: reload_id(call.bound.transport_token),
+      completion: reload_opaque_id(:request_completion, call.bound.completion),
+      session: reload_id(call.bound.session), session_monitor: reload_id(call.bound.monitor),
+      native: reload_id(call.captured.native), native_monitor: reload_id(call.captured.native_monitor),
+      native_actors: Enum.map(call.captured.actors, fn {pid, ref, reason} ->
+        %{pid: reload_id(pid), monitor: reload_id(ref), expected_down: reload_id(reason)} end),
+      native_reservation: call.captured.reservation, retained_bytes: call.captured.retained,
+      original_complete: :ok, session_down: :normal, child_and_token_removed_before_source: true}
+  end
+
+  defp reload_snapshot_receipt(snapshot) do
+    %{status: snapshot.status, independent_bytes: snapshot.bytes,
+      records: Enum.map(snapshot.records, fn {resource, record} ->
+        %{resource: reload_id(resource), custodian: reload_id(record.custodian),
+          capability: reload_id(record.capability), lifecycle: record.lifecycle,
+          admission: record.admission, retirement_requested: record.retirement_requested,
+          transport_confirmed: record.transport_confirmed, custodian_down: record.custodian_down,
+          original_payload_bytes: record.payload_bytes, independent_payload_bytes: :erlang.external_size(record.payload),
+          helpers: map_size(record.helpers), opening: record.opening}
+      end),
+      pins: Enum.map(snapshot.pins, fn {ref, pin} -> %{ref: reload_id(ref), original: reload_id(pin),
+        independent_bytes: :erlang.external_size(pin)} end),
+      tokens: Enum.map(snapshot.tokens, fn {ref, token} -> %{ref: reload_id(ref),
+        payload_bytes: token.payload_bytes, resource: reload_id(token.resource),
+        completion: reload_opaque_id(:request_completion, token.completion)} end),
+      monitors: Enum.map(snapshot.monitors, &reload_id/1)}
+  end
+
+  defp reload_group_snapshot_receipt(snapshot) do
+    %{groups: Enum.map(snapshot.groups, fn {key, record} -> %{key: reload_id(key),
+        installed_reserve: record.bytes, full_record_bytes: :erlang.external_size(Map.delete(record, :bytes)),
+        lifecycle: record.lifecycle, inflight: record.inflight, cursor: record.cursor} end),
+      pins: Enum.map(snapshot.pins, fn {ref, pin} -> %{ref: reload_id(ref), original: reload_id(pin),
+        control_bytes: pin.control_bytes} end),
+      tokens: Enum.map(snapshot.tokens, fn {ref, token} -> %{ref: reload_id(ref), key: reload_id(token.key),
+        control_bytes: token.control_bytes, completion: reload_opaque_id(:request_completion, token.completion)} end),
+      probes: Enum.map(snapshot.probes, fn {ref, probe} -> %{ref: reload_id(ref), key: reload_id(probe.key),
+        bytes: probe.bytes, control_bytes: probe.control_bytes,
+        completion: reload_opaque_id(:request_completion, probe.completion)} end),
+      config_bytes: snapshot.bytes, control_bytes: snapshot.control_bytes, probe_bytes: snapshot.probe_bytes,
+      limits: snapshot.limits, monitors: Enum.map(snapshot.monitors, &reload_id/1)}
+  end
+
+  defp reload_store_receipt(store) do
+    %{generation: reload_id(store.router.generation), router: reload_id(store.router),
+      full_router_bytes: :erlang.external_size(store.router),
+      baseline: Enum.map(store.baseline, &reload_id/1), full_baseline_bytes: :erlang.external_size(store.baseline),
+      preparation: reload_id(store.preparation), retired: reload_id(store.retired)}
+  end
+
+  defp reload_peer_public(epoch) do
+    %{epoch: epoch.index, lane: epoch.lane, peer: reload_id(epoch.peer), address: reload_id(epoch.address),
+      port: epoch.ready["port"], observed_setup_to_ready_ms: epoch.ready_elapsed_ms,
+      source_class: epoch.class, source_sha256: reload_hash(epoch.source), peer_identity: epoch.ready["identity"],
+      public_ca_bundle: Enum.map(epoch.source.trust || [], &%{bytes: byte_size(&1), sha256: reload_hash_binary(&1)})}
+  end
+
+  # Opaque capability identity is correlated by === without traversing or
+  # serializing its interior. Public PIDs/refs/finite source pins use inspect.
+  defp reload_opaque_id(kind, term) do
+    key = {__MODULE__, :reload_opaque_ids}
+    entries = Process.get(key, [])
+    case Enum.find(entries, fn {actual_kind, original, _} -> actual_kind == kind and original === term end) do
+      {_, _, id} -> %{opaque: kind, identity: id}
+      nil ->
+        id = length(entries) + 1
+        assert id <= 512
+        Process.put(key, [{kind, term, id} | entries])
+        %{opaque: kind, identity: id}
+    end
+  end
+
+  defp reload_id(%{__struct__: module} = term), do: reload_opaque_id(module, term)
+  defp reload_id(term), do: %{inspect: inspect(term, limit: :infinity, printable_limit: :infinity)}
+  defp reload_hash(term), do: term |> :erlang.term_to_binary() |> reload_hash_binary()
+  defp reload_hash_binary(bytes), do: Base.encode16(:crypto.hash(:sha256, bytes), case: :lower)
+  defp reload_emit(context, event, row),
+    do: IO.puts(JSON.encode!(Map.merge(context, Map.put(row, :event, "group_h2_reload_#{event}"))))
 end
