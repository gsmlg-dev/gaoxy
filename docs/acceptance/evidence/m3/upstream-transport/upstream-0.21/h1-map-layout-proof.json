    "abstract_model_cases": 108,
    "abstract_model_generator_source": "def hash_patterns(n, level):\n    import hashlib\n    mask = (1 << (4*level)) - 1\n    return {\n        \"full_hash_collision\": [0]*n,\n        \"two_collision_groups\": [i % 2 for i in range(n)],\n        \"sequential_hashes\": [i for i in range(n)],\n        \"last_nibble_difference\": [(i % 16) << (4*(level-1)) for i in range(n)],\n        \"paired_last_nibble\": [((i // 2) % 16) << (4*(level-1)) for i in range(n)],\n        \"sha256_index\": [int.from_bytes(hashlib.sha256(str(i).encode(\"utf-8\")).digest()[:8], \"little\") & mask for i in range(n)]\n    }\n",
    "abstract_model_levels": [
      8,
      16
    ],
    "abstract_model_source": "def model(hashes, level, depth=0, root=False):\n    n = len(hashes)\n    assert n > 0\n    if n == 1 and not root:\n        return (2, 0, 1, 0)\n    if depth == level:\n        assert n >= 2\n        return (1 + n + 2*n, 1, n, 1)\n    groups = {}\n    for value in hashes:\n        groups.setdefault((value >> (4*depth)) & 15, []).append(value)\n    parts = [model(values, level, depth+1) for values in groups.values()]\n    overhead = 2 if root else 1\n    return (overhead + len(groups) + sum(x[0] for x in parts),\n            1 + sum(x[1] for x in parts),\n            sum(x[2] for x in parts), sum(x[3] for x in parts))\n",
