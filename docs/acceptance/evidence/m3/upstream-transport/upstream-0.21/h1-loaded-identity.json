or each ebin but failed on beam_lib.md5 return shape. Repair2 matches the documented {:ok, {module, digest}} return. No runtime/product/test assertion changes.',\n    'initial_result': 'h1-loaded-identity-initial.json',\n    'repair1_result': 'h1-loaded-identity-repair1.json',\n    'command_shutdown': 'subprocess.run completed; no peer or background job started',\n    'metadata': json.loads(temporary.read_text()) if result.returncode == 0 else None,\n    'independent_review': 'PENDING',\n}\nout = evidence / 'h1-loaded-identity.json'\nout.write_text(json.dumps(receipt, indent=2, sort_keys=True) + '\\n')\nassert result.returncode == 0, result.stdout + result.stderr\nassert before == after\nassert receipt['metadata']['module_count'] == 34\nprint('PASS point-in-time identity:', receipt['metadata']['module_count'], 'modules;', len(expected), 'stable source hashes; exit', result.returncode)\n",
