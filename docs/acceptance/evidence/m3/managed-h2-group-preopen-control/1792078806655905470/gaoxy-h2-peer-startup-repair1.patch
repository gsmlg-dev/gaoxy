+            remaining = None if deadline is None else max(0, deadline - time.monotonic())
+            if not select.select([sys.stdin], [], [], remaining)[0]:
+                return None
+            data = os.read(sys.stdin.fileno(), 65536)
+            self.buffer += data
+            self.eof = not data
 
 
