+  # Failure-only, bounded observations. Never query held Service/gate actors.
+  defp guardian_recovery_diagnostic(f, guardian, completion) do
+    observe = fn owner, project ->
+      try do
+        project.(:sys.get_state(owner, 100))
+      rescue
+        error -> {:diagnostic_error, error.__struct__}
+      catch
+        kind, _ -> {:diagnostic_unavailable, kind}
+      end
+    end
+
+    actor = fn
+      pid when is_pid(pid) ->
+        %{pid: pid, alive: Process.alive?(pid),
+          process: Process.info(pid, [:status, :current_function, :message_queue_len])}
+      _ -> nil
+    end
+
+    groups = observe.(f.groups, fn state ->
+      %{tokens: map_size(state.tokens), pins: map_size(state.pins),
+        control_bytes: state.control_bytes,
+        groups: Enum.map(Enum.take(state.groups, 8), fn {key, held} ->
+          {key, held.lifecycle, held.inflight}
+        end),
+        holds: Enum.map(Enum.take(state.tokens, 8), fn {token, held} ->
+          %{token: token, guardian_original: held.guardian === guardian,
+            completion_original: held.completion === completion,
+            record: Map.take(held, [:monitor, :recovery_monitor, :deadline, :control_bytes]),
+            recovery: actor.(held.recovery)}
+        end)}
+    end)
+
+    transports = observe.(f.owner, fn state ->
+      %{tokens: map_size(state.tokens),
+        pins: Enum.sum(Enum.map(state.pins, fn {_, held} -> length(held.public.handles) end)),
+        helpers: Enum.sum(Enum.map(state.records, fn {_, held} ->
+          map_size(held.helpers) + if(held.opening, do: 1, else: 0)
+        end)) + Enum.count(state.tokens, fn {_, held} -> held.abort_helper != nil end),
+        request_timer: state.request_timer,
+        holds: Enum.map(Enum.take(state.tokens, 8), fn {token, held} ->
+          %{token: token, guardian_original: held.guardian === guardian,
+            completion_original: held.completion === completion,
+            record: Map.take(held, [:guardian_down, :abort_down, :abort_result, :cleanup_deadline]),
+            abort_helper: actor.(if held.abort_helper, do: elem(held.abort_helper, 0))}
+        end),
+        pin_holders: Enum.map(Enum.take(state.pins, 8), fn {ref, held} ->
+          %{ref: ref, kind: held.public.kind, holder: actor.(held.public.holder),
+            derived: Map.get(held, :derived, false), handles: length(held.public.handles)}
+        end),
+        resources: Enum.map(Enum.take(state.records, 8), fn {ref, held} ->
+          %{ref: ref, lifecycle: held.lifecycle, opening: held.opening,
+            helpers: map_size(held.helpers), transport_confirmed: held.transport_confirmed}
+        end)}
+    end)
+
+    IO.inspect(%{protocol: f.protocol, groups: groups, transports: transports},
+      label: "GUARDIAN_RECOVERY_PREDICATE_FAILURE", limit: :infinity, printable_limit: 2_000)
+  end
