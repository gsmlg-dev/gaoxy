+  defp ready_udp_endpoint(pid, id \\ "echo") do
+    eventually(fn ->
+      match?(
+        %{state: :ready, backend: %{mode: :running, receive_credit: 1}},
+        Gaoxy.status(pid, id)
+      )
+    end)
+
+    endpoint(pid, id)
+  end
